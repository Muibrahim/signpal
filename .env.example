# Core
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/signpal
PORT=3000
NODE_ENV=development

# AI design generation
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# Admin — both are mandatory in production
ADMIN_USER=
ADMIN_PASSWORD=

# Commerce
DESIGN_DOWNLOAD_PRICE_USD=15
# Confirmed by the owner: the competitor source prices are USD and approved.
PRICE_BOOK_MODE=approved
COMPETITOR_PRICE_CURRENCY=USD
# Optional per-unit production costs; add them later for margin protection.
FACTORY_COSTS_JSON={}
SIFALO_API_KEY=
SIFALO_API_URL=https://api.sifalopay.com/gateway/

# Optional analytics
POLSIA_ANALYTICS_SLUG=
