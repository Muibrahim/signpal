<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Prepress Job Ticket #<%= order.id %> — SignPal Production</title>
  <link rel="icon" href="/images/signpal-logo-640.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Sora:wght@400;600;700;800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #0b0f19;
      --paper: #ffffff;
      --border: #d1d5db;
      --border-dark: #111827;
      --muted: #6b7280;
      --cyan: #00a4e4;
      --magenta: #e4007f;
      --yellow: #ffed00;
      --black: #111827;
      --rich-black: #050505;
      --brand-orange: #fe6a00;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background: #f3f4f6;
      color: var(--ink);
      padding: 24px;
      line-height: 1.45;
    }

    .ticket-container {
      max-width: 900px;
      margin: 0 auto;
      background: var(--paper);
      border: 2px solid var(--border-dark);
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      padding: 32px;
      position: relative;
    }

    /* Print Controls Bar (Hidden in Print) */
    .ticket-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border);
      flex-wrap: wrap;
      gap: 12px;
    }

    .ticket-toolbar h1 {
      font-family: 'Sora', sans-serif;
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--border-dark);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .toolbar-actions {
      display: flex;
      gap: 10px;
    }

    .btn-action {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border-radius: 6px;
      font: 600 0.84rem 'Sora', sans-serif;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.15s;
    }

    .btn-print {
      background: var(--border-dark);
      color: #fff;
      border: 1px solid var(--border-dark);
    }
    .btn-print:hover { background: #374151; }

    .btn-wa {
      background: #25D366;
      color: #fff;
      border: 1px solid #20bd5a;
    }
    .btn-wa:hover { background: #1eb854; }

    .btn-back {
      background: #fff;
      color: var(--ink);
      border: 1px solid var(--border);
    }
    .btn-back:hover { background: #f9fafb; }

    /* Production Header */
    .prod-header {
      display: grid;
      grid-template-columns: 1fr auto auto;
      gap: 20px;
      padding-bottom: 20px;
      border-bottom: 2px solid var(--border-dark);
      margin-bottom: 20px;
      align-items: center;
    }

    .ticket-qr-traveler {
      display: flex;
      align-items: center;
      gap: 10px;
      background: #f9fafb;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 6px 10px;
    }

    .qr-traveler-img {
      border: 1px solid var(--border-dark);
      border-radius: 4px;
      display: block;
    }

    .qr-traveler-text {
      display: flex;
      flex-direction: column;
    }

    .qr-traveler-text span {
      font-family: 'Space Mono', monospace;
      font-size: 0.68rem;
      font-weight: 700;
      color: var(--border-dark);
      letter-spacing: 0.05em;
    }

    .qr-traveler-text small {
      font-size: 0.65rem;
      color: var(--muted);
    }

    .ticket-badge-box {
      text-align: right;
    }

    .job-id {
      font-family: 'Space Mono', monospace;
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--border-dark);
      letter-spacing: -0.02em;
    }

    .status-pill {
      display: inline-block;
      font-family: 'Space Mono', monospace;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 4px;
      margin-top: 4px;
    }
    .status-paid { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; }
    .status-unpaid { background: #fef9c3; color: #854d0e; border: 1px solid #fef08a; }

    /* Metadata Grids */
    .meta-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      padding: 16px 0;
      border-bottom: 1px solid var(--border);
    }

    .meta-card label {
      display: block;
      font-family: 'Space Mono', monospace;
      font-size: 0.68rem;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 4px;
    }

    .meta-card strong {
      display: block;
      font-size: 0.92rem;
      color: var(--ink);
    }

    .meta-card small {
      display: block;
      font-size: 0.78rem;
      color: var(--muted);
      margin-top: 2px;
    }

    /* Technical Press Specs Table */
    .section-title {
      font-family: 'Sora', sans-serif;
      font-size: 0.88rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin: 22px 0 10px 0;
      color: var(--border-dark);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .section-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .specs-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.84rem;
      margin-bottom: 20px;
    }

    .specs-table th,
    .specs-table td {
      padding: 8px 12px;
      text-align: left;
      border: 1px solid var(--border);
    }

    .specs-table th {
      background: #f9fafb;
      font-family: 'Space Mono', monospace;
      font-size: 0.72rem;
      text-transform: uppercase;
      color: var(--muted);
      width: 25%;
    }

    .specs-table td strong {
      color: var(--ink);
    }

    /* Prepress Artwork Frame with Crop Marks */
    .prepress-canvas-wrap {
      position: relative;
      background: #f9fafb;
      border: 1px dashed var(--border);
      padding: 30px;
      text-align: center;
      margin: 20px 0;
      overflow: hidden;
    }

    .artwork-stage {
      display: inline-block;
      position: relative;
      background: #000;
      box-shadow: 0 4px 15px rgba(0,0,0,0.15);
      border: 1px solid #333;
    }

    .artwork-stage img {
      display: block;
      max-width: 100%;
      max-height: 400px;
      object-fit: contain;
    }

    /* SVG Crop Marks Overlay */
    .crop-mark {
      position: absolute;
      width: 20px;
      height: 20px;
      stroke: #000;
      stroke-width: 1.5;
      fill: none;
    }
    .crop-tl { top: 8px; left: 8px; }
    .crop-tr { top: 8px; right: 8px; }
    .crop-bl { bottom: 8px; left: 8px; }
    .crop-br { bottom: 8px; right: 8px; }

    /* Bleed Outline */
    .bleed-guide-tag {
      position: absolute;
      top: 10px;
      left: 50%;
      transform: translateX(-50%);
      font-family: 'Space Mono', monospace;
      font-size: 0.65rem;
      background: rgba(254,106,0,0.9);
      color: #fff;
      padding: 2px 8px;
      border-radius: 3px;
    }

    /* CMYK Fogra39 Calibration Bar */
    .cmyk-bar {
      display: flex;
      height: 16px;
      margin: 18px 0;
      border: 1px solid var(--border-dark);
      border-radius: 2px;
      overflow: hidden;
    }
    .cmyk-patch {
      flex: 1;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Space Mono', monospace;
      font-size: 0.62rem;
      font-weight: 700;
      color: #fff;
      text-shadow: 0 1px 2px rgba(0,0,0,0.5);
    }
    .cmyk-c { background: #00a4e4; }
    .cmyk-m { background: #e4007f; }
    .cmyk-y { background: #ffed00; color: #000; text-shadow: none; }
    .cmyk-k { background: #111827; }
    .cmyk-rich { background: #000000; }
    .cmyk-50c { background: #80d2f2; color: #000; text-shadow: none; }
    .cmyk-50m { background: #f280bf; color: #000; text-shadow: none; }
    .cmyk-50y { background: #fff680; color: #000; text-shadow: none; }
    .cmyk-50k { background: #888888; }

    /* Quality Checklist */
    .checklist-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-top: 12px;
      background: #fafafa;
      border: 1px solid var(--border);
      padding: 14px;
      border-radius: 6px;
    }

    .check-item {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      font-size: 0.78rem;
    }

    .check-box {
      width: 14px;
      height: 14px;
      border: 1.5px solid var(--border-dark);
      border-radius: 2px;
      margin-top: 2px;
      flex-shrink: 0;
    }

    /* Sign-off Footer */
    .signoff-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px dashed var(--border);
    }

    .sign-box {
      border-bottom: 1px solid var(--border-dark);
      height: 40px;
      position: relative;
    }

    .sign-label {
      font-family: 'Space Mono', monospace;
      font-size: 0.68rem;
      text-transform: uppercase;
      color: var(--muted);
      position: absolute;
      bottom: -20px;
      left: 0;
    }

    /* Print Stylesheet */
    @media print {
      body { background: #fff; padding: 0; }
      .ticket-toolbar { display: none !important; }
      .ticket-container {
        border: none;
        box-shadow: none;
        padding: 0;
        max-width: 100%;
      }
      @page {
        margin: 12mm;
        size: A4 portrait;
      }
    }
  </style>
</head>
<body>

  <div class="ticket-container">

    <!-- Screen-only Toolbar -->
    <div class="ticket-toolbar">
      <h1>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/>
          <path d="M6 14h12v8H6z"/>
        </svg>
        RIP Production Job Ticket #<%= order.id %>
      </h1>
      <div class="toolbar-actions">
        <button type="button" class="btn-action btn-print" onclick="window.print()">
          🖨️ Print / Save as PDF
        </button>
        <%
          const waPhone = '252634226437';
          const host = process.env.BASE_URL || 'https://signpal.so';
          const printAssetUrl = order.upscaled_design_url || order.flat_design_url || '';
          const waMsg = `🚨 DALABKA WARSHADDA: Order #${order.id}
Alaabta: ${spec.name} (${order.quantity || 1} pcs)
Macmiilka: ${order.customer_name} (${order.customer_phone || 'N/A'})
Cabirka Trim: ${spec.widthMm || 'Custom'}x${spec.heightMm || ''}mm (+${spec.bleedMm}mm bleed)
Substrate: ${material.substrate}
Faylka Daabacaadda: ${printAssetUrl}
Job Ticket: ${host}/order/${order.public_token}/ticket`;
        %>
        <a href="https://wa.me/<%= waPhone %>?text=<%= encodeURIComponent(waMsg) %>" target="_blank" class="btn-action btn-wa">
          📲 Dispatch to Floor (WhatsApp)
        </a>
        <a href="/admin" class="btn-action btn-back">
          ← Back to Admin
        </a>
      </div>
    </div>

    <!-- Production Facility Header -->
    <header class="prod-header">
      <div>
        <div class="brand-mark">Sign<span>Pal</span> Prepress</div>
        <div class="prod-facility">Industrial Digital Press & Fabrication Facility · Horn of Africa</div>
      </div>
      <div class="ticket-qr-traveler" title="Scan with mobile phone to advance floor stage">
        <%
          const qrScanUrl = (process.env.BASE_URL || 'https://signpal.net') + '/admin/orders/' + order.id + '/scan-action';
        %>
        <img src="https://api.qrserver.com/v1/create-qr-code/?size=140x140&margin=1&data=<%= encodeURIComponent(qrScanUrl) %>" alt="QR Floor Traveler" width="68" height="68" class="qr-traveler-img" />
        <div class="qr-traveler-text">
          <span>QR TRAVELER</span>
          <small>Scan to advance</small>
        </div>
      </div>
      <div class="ticket-badge-box">
        <div class="job-id">JOB #<%= String(order.id).padStart(5, '0') %></div>
        <span class="status-pill <%= order.payment_status === 'paid' ? 'status-paid' : 'status-unpaid' %>">
          <%= order.payment_status === 'paid' ? '✓ PAYMENT VERIFIED (' + (order.payment_provider || 'SIFALO').toUpperCase() + ')' : '⚠️ PAYMENT UNCONFIRMED' %>
        </span>
      </div>
    </header>

    <!-- Metadata Section -->
    <div class="meta-grid">
      <div class="meta-card">
        <label>Client / Customer</label>
        <strong><%= order.customer_name || 'Anonymous' %></strong>
        <small><%= order.customer_phone || order.customer_email %></small>
      </div>
      <div class="meta-card">
        <label>Product & Format</label>
        <strong><%= spec.name %></strong>
        <small><%= order.product_type %></small>
      </div>
      <div class="meta-card">
        <label>Job Quantity</label>
        <strong><%= order.quantity || 1 %> Units</strong>
        <small><%= order.fulfillment_type === 'download' ? 'Digital Download' : 'Physical Delivery' %></small>
      </div>
      <div class="meta-card">
        <label>Entry Timestamp</label>
        <strong><%= new Date(order.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></strong>
        <small><%= new Date(order.created_at).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) %> Local</small>
      </div>
    </div>

    <!-- Technical Prepress Matrix -->
    <h2 class="section-title">Pressroom Fabrication Matrix</h2>
    <table class="specs-table">
      <tbody>
        <tr>
          <th>Finished Trim Size</th>
          <td><strong><%= spec.widthMm ? spec.widthMm + ' × ' + spec.heightMm + ' mm' : 'Custom Site Measurement' %></strong></td>
          <th>Bleed Margin Allowance</th>
          <td><strong>+<%= spec.bleedMm %> mm (Total cut: <%= spec.widthMm ? (spec.widthMm + spec.bleedMm * 2) + ' × ' + (spec.heightMm + spec.bleedMm * 2) + ' mm' : 'Variable' %>)</strong></td>
        </tr>
        <tr>
          <th>Target RIP Resolution</th>
          <td><strong><%= spec.dpi %> DPI @ 100% Physical Scale</strong></td>
          <th>Color Gamut Profile</th>
          <td><strong><%= spec.colorSpace %> (ISO Fogra39 / SWOP)</strong></td>
        </tr>
        <tr>
          <th>Substrate / Stock</th>
          <td colspan="3"><%= material.substrate %></td>
        </tr>
        <tr>
          <th>Ink Technology</th>
          <td colspan="3"><%= material.inkSystem %></td>
        </tr>
        <tr>
          <th>Finishing & Bindery</th>
          <td colspan="3"><%= material.finishing %></td>
        </tr>
        <tr>
          <th>Packaging & Handling</th>
          <td colspan="3"><%= material.packing %> · Estimated turnaround: <strong><%= material.turnaroundHours %>h</strong></td>
        </tr>
        <% if (order.user_description) { %>
        <tr>
          <th>Client Instructions</th>
          <td colspan="3"><%= order.user_description %></td>
        </tr>
        <% } %>
      </tbody>
    </table>

    <!-- Prepress Artwork Frame with Crop Marks -->
    <h2 class="section-title">Prepress Artwork & Bleed Registration View</h2>
    <div class="prepress-canvas-wrap">
      <!-- Crop Marks at 4 Corners -->
      <svg class="crop-mark crop-tl" viewBox="0 0 20 20"><path d="M0,10 H15 M10,0 V15"/></svg>
      <svg class="crop-mark crop-tr" viewBox="0 0 20 20"><path d="M5,10 H20 M10,0 V15"/></svg>
      <svg class="crop-mark crop-bl" viewBox="0 0 20 20"><path d="M0,10 H15 M10,5 V20"/></svg>
      <svg class="crop-mark crop-br" viewBox="0 0 20 20"><path d="M5,10 H20 M10,5 V20"/></svg>
      <span class="bleed-guide-tag"><%= spec.bleedMm %>mm BLEED SAFETY CUT BOUNDARY</span>

      <div class="artwork-stage">
        <% 
          const displayImg = order.upscaled_design_url || order.flat_design_url || (designs[order.selected_design] ? (designs[order.selected_design].url || designs[order.selected_design]) : '');
        %>
        <% if (displayImg) { %>
          <img src="<%= displayImg %>" alt="Production Flat Artwork">
        <% } else { %>
          <div style="padding: 60px 40px; color: #fff; font-family: 'Space Mono', monospace; font-size: 0.85rem;">
            [ AWAITING HIGH-RESOLUTION ARTWORK EXTRACTION ]
          </div>
        <% } %>
      </div>
    </div>

    <!-- CMYK Fogra39 Inking Calibration Bar -->
    <div class="cmyk-bar" title="Fogra39 Process Inking Calibration Strip">
      <div class="cmyk-patch cmyk-c">C 100%</div>
      <div class="cmyk-patch cmyk-m">M 100%</div>
      <div class="cmyk-patch cmyk-y">Y 100%</div>
      <div class="cmyk-patch cmyk-k">K 100%</div>
      <div class="cmyk-patch cmyk-rich">RICH BLK</div>
      <div class="cmyk-patch cmyk-50c">C 50%</div>
      <div class="cmyk-patch cmyk-50m">M 50%</div>
      <div class="cmyk-patch cmyk-50y">Y 50%</div>
      <div class="cmyk-patch cmyk-50k">K 50%</div>
    </div>

    <!-- Shop Floor Prepress Quality Sign-Off -->
    <h2 class="section-title">Shop Floor Prepress Quality Checklist</h2>
    <div class="checklist-grid">
      <div class="check-item">
        <div class="check-box"></div>
        <span>Resolution ≥ <%= spec.dpi %> DPI verified on RIP</span>
      </div>
      <div class="check-item">
        <div class="check-box"></div>
        <span>Fogra39 gamut out-of-gamut check passed</span>
      </div>
      <div class="check-item">
        <div class="check-box"></div>
        <span><%= spec.bleedMm %>mm bleed margin inspected</span>
      </div>
      <div class="check-item">
        <div class="check-box"></div>
        <span>Text & spellcheck matched against brief</span>
      </div>
      <div class="check-item">
        <div class="check-box"></div>
        <span>Substrate stock verified in warehouse</span>
      </div>
      <div class="check-item">
        <div class="check-box"></div>
        <span>Finishing & packaging checklist cleared</span>
      </div>
    </div>

    <!-- Sign-off Line -->
    <div class="signoff-grid">
      <div class="sign-box">
        <span class="sign-label">Prepress RIP Operator Signature & Date</span>
      </div>
      <div class="sign-box">
        <span class="sign-label">Production Floor Supervisor Approval</span>
      </div>
    </div>

  </div>

</body>
</html>
