<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= page.title %> — <%= content.global.siteName %></title>
  <meta name="description" content="<%= page.intro %>">
  <link rel="icon" href="<%= content.global.logoUrl %>" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body>
  <%- include('partials/topbar') %>
  <%- include('partials/nav') %>
  <main>
    <header class="page-hero">
      <div class="section-shell">
        <span class="eyebrow"><%= page.eyebrow %></span>
        <h1><%= page.title %></h1>
        <p><%= page.intro %></p>
        <div class="button-row"><a class="button button-primary" href="/design"><%= content.labels.startOrder %></a><a class="button button-light" href="/contact"><%= content.labels.talkProduction %></a></div>
      </div>
    </header>

    <% if (slug === 'products') { %>
      <section class="section section-white"><div class="section-shell"><div class="catalog-grid">
        <% products.forEach((product) => { %><article class="catalog-card"><span><%= product.category %></span><h2><%= product.name %></h2><p><%= product.format %></p><a href="/design?product=<%= product.id %>">Configure product →</a></article><% }) %>
      </div></div></section>
    <% } else if (slug === 'contact') { %>
      <section class="section section-white" id="contact"><div class="section-shell contact-grid"><div><span class="eyebrow"><%= page.sectionEyebrow %></span><h2><%= page.sectionTitle %></h2><p class="section-copy"><%= page.instructions %></p></div><div class="contact-panel"><span>Phone <strong><%= content.global.phone || 'Not published' %></strong></span><a href="https://wa.me/<%= content.global.whatsappDigits %>">WhatsApp <strong><%= content.global.whatsappNumber %></strong></a><a href="mailto:<%= content.global.email %>">Email <strong><%= content.global.email %></strong></a><span>Factory <strong><%= content.global.address %></strong></span><span>Opening hours <strong><%= content.global.openingHours %></strong></span><span>Service area <strong><%= content.global.serviceArea %></strong></span></div></div></section>
    <% } else if (page.cards) { %>
      <section class="section section-white"><div class="section-shell"><div class="content-card-grid"><% page.cards.forEach((card, index) => { %><article><b><%= String(index + 1).padStart(2, '0') %></b><h2><%= card[0] %></h2><p><%= card[1] %></p></article><% }) %></div><div class="page-action-panel"><div><span class="eyebrow"><%= content.labels.readyEyebrow %></span><h2><%= content.labels.readyTitle %></h2></div><div class="button-row"><a class="button button-primary" href="/design"><%= content.labels.startOrder %></a><a class="button button-light" href="/contact"><%= content.labels.requestQuote %></a></div></div></div></section>
    <% } else { %>
      <%- include('partials/company-sections') %>
    <% } %>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
