<section class="section section-white" id="products"><div class="section-shell"><div class="section-heading"><div><span class="eyebrow"><%= content.showcase.eyebrow %></span><h2><%= content.showcase.title %></h2></div><a href="/products" class="text-link"><%= content.showcase.linkLabel %></a></div><div class="product-feature-grid">
  <% content.showcase.items.forEach((item, index) => { %><a class="product-feature <%= index === 0 ? 'product-feature-large' : '' %>" href="<%= item.href %>" style="--cms-image:url('<%= item.imageUrl %>')"><span><%= item.label %></span><h3><%= item.title %></h3><p><%= item.description %></p></a><% }) %>
</div></div></section>
