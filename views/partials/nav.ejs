<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo"><img src="<%= content.global.logoUrl %>" alt="<%= content.global.siteName %>" class="nav-logo-image"></a>
    <button class="nav-toggle" type="button" aria-label="Open navigation" onclick="this.parentElement.classList.toggle('nav-open')">Menu</button>
    <div class="nav-links">
      <% content.navigation.forEach((item) => { %><a href="<%= item.href %>" class="nav-link <%= typeof slug !== 'undefined' && slug === item.slug ? 'active' : '' %>" <%= typeof slug !== 'undefined' && slug === item.slug ? 'aria-current="page"' : '' %>><%= item.label %></a><% }) %>
      <a href="/design" class="nav-link nav-link-primary <%= typeof slug !== 'undefined' && slug === 'design' ? 'active' : '' %>" <%= typeof slug !== 'undefined' && slug === 'design' ? 'aria-current="page"' : '' %>><%= content.labels.startOrder %></a>
    </div>
  </div>
</nav>
