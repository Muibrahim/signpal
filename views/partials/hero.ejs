<section class="hero">
  <div class="hero-photo" role="img" aria-label="<%= content.hero.imageAlt %>" style="background-image:url('<%= content.hero.imageUrl %>')"></div><div class="hero-shade"></div>
  <div class="hero-inner"><div class="hero-text"><div class="hero-eyebrow"><%= content.hero.eyebrow %></div><h1 class="hero-headline"><%= content.hero.titleLine1 %><br><%= content.hero.titleLine2 %><br><span><%= content.hero.titleAccent %></span></h1><p class="hero-lede"><%= content.hero.description %></p><div class="hero-actions"><a href="/design" class="button button-primary"><%= content.hero.primaryButton %></a><a href="/products" class="button button-ghost"><%= content.hero.secondaryButton %></a></div><div class="hero-trust"><% content.hero.trustItems.forEach((item) => { %><span><%= item %></span><% }) %></div></div></div>
  <p class="photo-disclosure"><%= content.hero.disclosure %></p>
</section>
<section class="hero-facts"><div class="section-shell"><% content.hero.facts.forEach((fact) => { %><article><b><%= fact.value %></b><span><%= fact.label %></span></article><% }) %></div></section>
