<section class="section design-story" id="how-it-works"><div class="section-shell design-story-grid"><div class="design-story-copy"><span class="eyebrow eyebrow-light"><%= content.process.eyebrow %></span><h2><%= content.process.title %></h2><p><%= content.process.description %></p><div class="step-list"><% content.process.steps.forEach((step,index) => { %><span><b><%= String(index + 1).padStart(2,'0') %></b> <%= step %></span><% }) %></div><a href="/design" class="button button-primary"><%= content.process.buttonLabel %></a></div><div class="concept-demo"><div class="concept-card concept-a"><span>01 · Clean</span><strong>YOUR<br>BRAND</strong></div><div class="concept-card concept-b"><span>02 · Bold</span><strong>MAKE<br>NOISE.</strong></div><div class="concept-card concept-c"><span>03 · Premium</span><strong>Designed<br>to last.</strong></div><div class="mockup-label">Three distinct design routes</div></div></div></section>
