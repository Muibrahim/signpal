<section class="section section-white" id="work"><div class="section-shell"><div class="section-heading"><div><span class="eyebrow"><%= content.portfolio.eyebrow %></span><h2><%= content.portfolio.title %></h2></div><a class="text-link" href="/portfolio"><%= content.portfolio.linkLabel %></a></div><div class="portfolio-grid"><% content.portfolio.items.forEach((item) => { %><article class="portfolio-item" style="background-image:url('<%= item.imageUrl %>')"><div><span><%= item.label %></span><h3><%= item.title %></h3></div></article><% }) %></div><p class="portfolio-note"><%= content.portfolio.note %></p></div></section>
