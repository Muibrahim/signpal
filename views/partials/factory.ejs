<section class="section factory-section"><div class="section-shell split-feature"><div class="feature-photo" style="background-image:linear-gradient(0deg,rgba(7,16,66,.8),rgba(7,16,66,.04)),url('<%= content.factory.imageUrl %>')"><span class="photo-note"><%= content.factory.imageNote %></span></div><div><span class="eyebrow eyebrow-light"><%= content.factory.eyebrow %></span><h2><%= content.factory.title %></h2><p class="section-copy"><%= content.factory.description %></p><div class="quality-grid"><% content.factory.steps.forEach((step,index) => { %><span><b><%= String(index + 1).padStart(2,'0') %></b><%= step %></span><% }) %></div><a href="/about" class="button button-light"><%= content.labels.aboutCompany %></a></div></div></section>
