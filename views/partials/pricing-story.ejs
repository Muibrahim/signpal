<section class="section section-tint"><div class="section-shell"><div class="section-heading"><div><span class="eyebrow"><%= content.pricing.eyebrow %></span><h2><%= content.pricing.title %></h2></div></div><div class="price-paths"><% content.pricing.items.forEach((item) => { %><article><span><%= item.label %></span><h3><%= item.title %></h3><p><%= item.description %></p><a href="/design"><%= item.linkLabel %></a></article><% }) %></div><p class="pricing-condition"><%= content.pricing.note %></p></div></section>
