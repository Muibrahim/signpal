<section class="section section-tint"><div class="section-shell"><span class="eyebrow"><%= content.pathways.eyebrow %></span><h2><%= content.pathways.title %></h2><div class="path-grid"><% content.pathways.items.forEach((item, index) => { %><article class="<%= index === 0 ? 'path-primary' : '' %>"><b><%= String(index + 1).padStart(2,'0') %></b><h3><%= item.title %></h3><p><%= item.description %></p><a href="<%= item.href %>"><%= item.linkLabel %></a></article><% }) %></div></div></section>
