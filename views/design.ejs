<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Design — SignPal</title>
  <link rel="icon" href="/images/signpal-logo-640.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/design.css">
</head>
<body>
  <%- include('partials/nav') %>

  <main class="design-main">
    <div class="design-container">

      <!-- Request Step -->
      <section id="step-request" class="design-step active">
        <div class="step-header">
          <span class="step-number">01</span>
          <h1 class="step-title">Create your design</h1>
          <p class="step-subtitle">Choose a product and tell us what it should communicate. SignPal will create three distinct directions for you.</p>
        </div>

        <form id="request-form" class="request-form">
          <div class="form-group product-picker-group">
            <label for="product-search">What would you like to make?</label>
            <div class="product-search-wrap">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
              <input id="product-search" type="search" placeholder="Search books, banners, signs, stickers…" autocomplete="off">
            </div>
            <input id="productType" name="productType" type="hidden" value="business_card">
            <div class="product-tabs" role="tablist" aria-label="Product categories">
              <% productCategories.forEach((category, index) => { %>
                <button type="button" class="product-tab <%= index === 0 ? 'active' : '' %>" data-category="<%= category.id %>"><%= category.name %></button>
              <% }) %>
            </div>
            <div id="product-grid" class="product-grid">
              <% products.forEach((product) => { %>
                <button type="button" class="product-card <%= product.id === 'business_card' ? 'selected' : '' %>" data-product-id="<%= product.id %>" data-product-name="<%= product.name.toLowerCase() %>" data-categories="<%= product.categories.join(' ') %>">
                  <span class="product-card-mark"><%= product.name.charAt(0) %></span>
                  <span class="product-card-copy"><strong><%= product.name %></strong><small><%= product.format %></small></span>
                  <span class="product-card-check">✓</span>
                </button>
              <% }) %>
            </div>
            <button id="show-all-products" type="button" class="btn-show-products">View all products</button>
            <div id="custom-product-fields" class="custom-product-fields" hidden>
              <div class="form-row">
                <div class="form-group"><label for="customProductName">Product name</label><input id="customProductName" type="text" placeholder="e.g. branded tent"></div>
                <div class="form-group"><label for="customProductSize">Approximate size</label><input id="customProductSize" type="text" placeholder="e.g. 3 m × 3 m"></div>
              </div>
              <div class="form-row">
                <div class="form-group"><label for="customProductQuantity">Quantity</label><input id="customProductQuantity" type="number" min="1" value="1"></div>
                <div class="form-group"><label for="customProductUse">Where will it be used?</label><select id="customProductUse"><option>Indoor</option><option>Outdoor</option><option>Both</option><option>Not sure</option></select></div>
              </div>
              <p class="custom-note">Custom fabrication is reviewed before a final production price is charged.</p>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="languages">Language & Script</label>
              <select id="languages" name="languages" class="form-select">
                <option value="English + Somali">English + Somali (Bi-lingual)</option>
                <option value="English + Arabic">English + Arabic (Calligraphic)</option>
                <option value="Somali + Arabic">Somali + Arabic</option>
                <option value="English Only">English Only</option>
                <option value="Somali Only">Somali Only</option>
              </select>
            </div>
            <div class="form-group">
              <label for="quantity">Estimated quantity</label>
              <input id="quantity" name="quantity" type="number" min="1" value="100">
            </div>
          </div>

          <div id="price-estimate" class="price-estimate"><span>Estimated print price</span><strong>Choose a product and quantity</strong><small>Final price depends on current factory cost and specifications.</small></div>

          <div class="form-group">
            <label for="brandId">Brand DNA Profile <span class="label-optional">(Optional — applies brand colors & font rules)</span></label>
            <select id="brandId" name="brandId" class="form-select">
              <option value="">No Brand Selected (New Design)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="description">What do you need?</label>
            <textarea id="description" name="description" rows="5" placeholder="e.g. Business card for Mustafe Ibrahim Ahmed, Founder of Grow Media. Phone: +252 63 4226437, Hargeisa, Somaliland." maxlength="1000" required></textarea>
            <div class="desc-footer">
              <span class="char-count"><span id="char-count">0</span>/1000</span>
            </div>
          </div>

          <div class="form-group">
            <label>Inspiration images <span class="label-optional">(optional, up to 3)</span></label>
            <div class="upload-area" id="upload-area">
              <input type="file" id="file-input" name="images" accept="image/*" multiple hidden>
              <div class="upload-placeholder" id="upload-placeholder">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
                </svg>
                <p>Drop images here or <span class="upload-link">click to browse</span></p>
                <p class="upload-hint">PNG, JPG, WEBP — up to 3 files</p>
              </div>
              <div class="upload-previews" id="upload-previews"></div>
            </div>
          </div>

          <button type="submit" class="btn-generate">
            <span class="btn-text">Generate My Design</span>
            <span class="btn-loading" hidden>
              <svg class="spinner" viewBox="0 0 24 24" width="20" height="20">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="30 70" stroke-linecap="round"/>
              </svg>
              Generating your designs...
            </span>
          </button>
        </form>

        <div id="request-error" class="error-msg" hidden></div>
      </section>

      <!-- Pick Step -->
      <section id="step-pick" class="design-step">
        <div class="step-header">
          <span class="step-number">02</span>
          <h1 class="step-title">Pick Your Design</h1>
          <p class="step-subtitle">Here are 3 AI-generated options. Choose the one you love and we'll get started.</p>
          <button type="button" class="btn-back" data-goto="step-request">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
            Try a different description
          </button>
        </div>

        <div id="designs-grid" class="designs-grid"></div>

        <div id="pick-actions" class="pick-actions">
          <button type="button" class="btn-primary" id="btn-order" disabled>Continue to Order</button>
          <p id="pick-hint" class="pick-hint">Select a design above to continue</p>
        </div>
      </section>

      <!-- Order Step -->
      <section id="step-order" class="design-step">
        <div class="step-header">
          <span class="step-number">03</span>
          <h1 class="step-title">Submit Your Order</h1>
          <p class="step-subtitle">We'll review your design and contact you within 24 hours.</p>
          <button type="button" class="btn-back" data-goto="step-pick">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
            Back to designs
          </button>
        </div>

        <div class="order-selected mockup-stage" id="mockup-stage">
          <div class="mockup-scene" id="mockup-scene">
            <img id="order-design-img" src="" alt="Selected design">
          </div>
          <div class="order-design-label">
            <span class="design-num"><span id="order-product-name">Product</span> mockup · Concept <span id="order-design-num">1</span></span>
          </div>
        </div>

        <form id="order-form" class="order-form">
          <fieldset class="fulfillment-picker">
            <legend>What would you like to do?</legend>
            <label class="fulfillment-card selected">
              <input type="radio" name="fulfillmentType" value="print" checked>
              <span><strong>Print it with SignPal</strong><small>Your design is free. Pay for production and delivery.</small></span>
              <b>Recommended</b>
            </label>
            <label class="fulfillment-card">
              <input type="radio" name="fulfillmentType" value="download">
              <span><strong>Download the design</strong><small>Pay the design fee, then receive production-ready files.</small></span>
            </label>
          </fieldset>

          <div class="form-row">
            <div class="form-group">
              <label for="customerName">Your Name</label>
              <input type="text" id="customerName" name="customerName" placeholder="Ali Mohamed" required>
            </div>
            <div class="form-group">
              <label for="customerEmail">Email</label>
              <input type="email" id="customerEmail" name="customerEmail" placeholder="ali@example.com" required>
            </div>
          </div>

          <div class="form-group">
            <label for="customerPhone">Phone (optional)</label>
            <input type="tel" id="customerPhone" name="customerPhone" placeholder="+252 61 234 5678">
          </div>

          <button type="submit" class="btn-primary btn-submit">
            <span class="btn-text">Continue to secure payment</span>
            <span class="btn-loading" hidden>
              <svg class="spinner" viewBox="0 0 24 24" width="20" height="20">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="30 70" stroke-linecap="round"/>
              </svg>
              Submitting...
            </span>
          </button>
        </form>

        <div id="order-success" class="success-panel" hidden>
          <div class="success-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 6L9 17l-5-5"/>
            </svg>
          </div>
          <h2>Order saved</h2>
          <p id="payment-next-message">Payment must be completed before production or download.</p>
          <a href="/design" class="btn-outline">Design Something Else</a>
        </div>

        <div id="order-error" class="error-msg" hidden></div>
      </section>

    </div>
  </main>

  <script>
    const STATE = {
      description: null,
      images: [],       // File objects
      designs: [],
      selectedDesign: null,
      loadingDesigns: false,
      product: null,
    };

    const productSearch = $('product-search');
    const productCards = [...document.querySelectorAll('.product-card')];
    const PRODUCT_MINIMUMS = { business_card: 100, brochure: 20, flyer: 20, letterhead: 100, envelope: 100, sticker: 12, product_label: 12 };
    let activeProductCategory = 'popular';

    function filterProducts() {
      const query = productSearch.value.trim().toLowerCase();
      productCards.forEach(card => {
        const matchesSearch = !query || card.dataset.productName.includes(query);
        const matchesCategory = query || activeProductCategory === 'all' || card.dataset.categories.split(' ').includes(activeProductCategory);
        card.hidden = !(matchesSearch && matchesCategory);
      });
    }

    productCards.forEach(card => card.addEventListener('click', () => {
      productCards.forEach(item => item.classList.remove('selected'));
      card.classList.add('selected');
      $('productType').value = card.dataset.productId;
      $('quantity').value = PRODUCT_MINIMUMS[card.dataset.productId] || 1;
      $('custom-product-fields').hidden = card.dataset.productId !== 'custom';
      refreshPriceEstimate();
    }));

    document.querySelectorAll('.product-tab').forEach(tab => tab.addEventListener('click', () => {
      document.querySelectorAll('.product-tab').forEach(item => item.classList.remove('active'));
      tab.classList.add('active');
      activeProductCategory = tab.dataset.category;
      productSearch.value = '';
      filterProducts();
    }));

    productSearch.addEventListener('input', filterProducts);
    $('show-all-products').addEventListener('click', () => {
      activeProductCategory = 'all';
      document.querySelectorAll('.product-tab').forEach(item => item.classList.remove('active'));
      productSearch.value = '';
      filterProducts();
      $('show-all-products').hidden = true;
    });
    filterProducts();

    let priceEstimateTimer;
    async function refreshPriceEstimate() {
      clearTimeout(priceEstimateTimer);
      priceEstimateTimer = setTimeout(async () => {
        const panel = $('price-estimate');
        try {
          const query = new URLSearchParams({ productType: $('productType').value, quantity: $('quantity').value || '1' });
          const res = await fetch(`/api/pricing/estimate?${query}`);
          const estimate = await res.json();
          if (estimate.available) {
            const currency = estimate.mode === 'approved' ? '$' : '';
            const suffix = estimate.mode === 'approved' ? '' : ' provisional units';
            panel.querySelector('strong').textContent = `${currency}${Number(estimate.total).toFixed(2)}${suffix} · ${currency}${Number(estimate.unitPrice).toFixed(2)} per ${estimate.unit}`;
            panel.querySelector('small').textContent = estimate.quoteRequired
              ? 'We will confirm this estimate before payment.'
              : estimate.marginProtected
                ? '10% competitor reduction with SignPal minimum-margin protection.'
                : 'Exact SignPal price: 10% below the approved competitor baseline.';
          } else {
            panel.querySelector('strong').textContent = 'Custom quote required';
            panel.querySelector('small').textContent = estimate.reason || 'Specifications must be confirmed.';
          }
        } catch (_) { panel.querySelector('strong').textContent = 'Estimate temporarily unavailable'; }
      }, 180);
    }
    $('quantity').addEventListener('input', refreshPriceEstimate);
    refreshPriceEstimate();

    function $(id) {
      return document.getElementById(id) || { textContent: '', style: {}, classList: { add() {}, remove() {}, toggle() {} }, hidden: false, addEventListener() {} };
    }

    function goToStep(stepId) {
      document.querySelectorAll('.design-step').forEach(s => s.classList.remove('active'));
      $(stepId).classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // --- File upload handling ---
    const fileInput = $('file-input');
    const uploadArea = $('upload-area');
    const uploadPlaceholder = $('upload-placeholder');
    const uploadPreviews = $('upload-previews');

    function renderPreviews() {
      uploadPreviews.innerHTML = '';
      if (STATE.images.length === 0) {
        uploadPlaceholder.style.display = '';
        return;
      }
      uploadPlaceholder.style.display = 'none';

      STATE.images.forEach((file, i) => {
        const div = document.createElement('div');
        div.className = 'preview-item';

        const reader = new FileReader();
        reader.onload = (e) => {
          div.innerHTML = `
            <img src="${e.target.result}" alt="Inspiration ${i + 1}">
            <button type="button" class="preview-remove" data-index="${i}">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M18 6L6 18M6 6l12 12"/>
              </svg>
            </button>
          `;
          div.querySelector('.preview-remove').addEventListener('click', (e) => {
            e.stopPropagation();
            STATE.images.splice(i, 1);
            renderPreviews();
          });
        };
        reader.readAsDataURL(file);
        uploadPreviews.appendChild(div);
      });

      if (STATE.images.length < 3) {
        const addMore = document.createElement('div');
        addMore.className = 'preview-add-more';
        addMore.innerHTML = `
          <button type="button" id="add-more-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 5v14M5 12h14"/>
            </svg>
            Add more
          </button>
        `;
        uploadPreviews.appendChild(addMore);
        $('add-more-btn').addEventListener('click', () => fileInput.click());
      }
    }

    uploadArea.addEventListener('click', () => fileInput.click());
    uploadArea.addEventListener('dragover', (e) => {
      e.preventDefault();
      uploadArea.classList.add('drag-over');
    });
    uploadArea.addEventListener('dragleave', () => {
      uploadArea.classList.remove('drag-over');
    });
    uploadArea.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadArea.classList.remove('drag-over');
      addFiles(e.dataTransfer.files);
    });

    fileInput.addEventListener('change', (e) => {
      addFiles(e.target.files);
      fileInput.value = '';
    });

    function addFiles(files) {
      for (const file of files) {
        if (STATE.images.length >= 3) break;
        if (!file.type.startsWith('image/')) continue;
        STATE.images.push(file);
      }
      renderPreviews();
    }

    async function loadBrandProfiles() {
      try {
        const res = await fetch('/api/brands');
        if (!res.ok) return;
        const { brands } = await res.json();
        const select = $('brandId');
        if (select && brands && brands.length > 0) {
          select.innerHTML = '<option value="">No Brand Selected (New Design)</option>' +
            brands.map(b => `<option value="${b.id}">${b.name} (${b.industry || 'Brand Profile'})</option>`).join('');
        }
      } catch (_) {}
    }
    loadBrandProfiles();

    // --- Character counter ---
    $('description').addEventListener('input', (e) => {
      $('char-count').textContent = e.target.value.length;
    });

    // --- Submit request form ---
    $('request-form').addEventListener('submit', async (e) => {
      e.preventDefault();

      let description = $('description').value.trim();
      if (!description) return;

      if ($('productType').value === 'custom') {
        const customName = $('customProductName').value.trim();
        if (!customName) {
          $('request-error').textContent = 'Please tell us the name of your custom product.';
          $('request-error').hidden = false;
          return;
        }
        description = `Custom product: ${customName}. Approximate size: ${$('customProductSize').value || 'not specified'}. Quantity: ${$('customProductQuantity').value || '1'}. Use: ${$('customProductUse').value}. ${description}`;
      }

      STATE.description = description;
      STATE.designs = [];
      STATE.selectedDesign = null;

      const btn = e.target.querySelector('.btn-generate');
      btn.querySelector('.btn-text').hidden = true;
      btn.querySelector('.btn-loading').hidden = false;
      btn.disabled = true;
      $('request-error').hidden = true;
      STATE.loadingDesigns = true;

      try {
        // Convert File objects to base64 data URLs for JSON transport
        const imageDataUrls = await Promise.all(
          STATE.images.map(f => new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = e => resolve(e.target.result);
            reader.onerror = reject;
            reader.readAsDataURL(f);
          }))
        );

        const productType = $('productType')?.value || 'business_card';
        const languages = $('languages')?.value || 'English + Somali';
        const brandId = $('brandId')?.value || '';

        const res = await fetch('/api/generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            description,
            images: imageDataUrls,
            productType,
            languages,
            brandId
          }),
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Generation failed');

        STATE.designs = data.designs;
        STATE.product = data.product;
        renderDesignGrid();
        goToStep('step-pick');
      } catch (err) {
        $('request-error').textContent = err.message;
        $('request-error').hidden = false;
      } finally {
        btn.querySelector('.btn-text').hidden = false;
        btn.querySelector('.btn-loading').hidden = true;
        btn.disabled = false;
        STATE.loadingDesigns = false;
      }
    });

    function renderDesignGrid() {
      const grid = $('designs-grid');
      grid.innerHTML = '';

      STATE.designs.forEach((d, i) => {
        const card = document.createElement('div');
        card.className = 'design-card';
        card.dataset.index = i;
        card.onclick = () => selectDesign(i);
        card.innerHTML = `
          <div class="design-img-wrap">
            <img src="${d.url}" alt="Design option ${i + 1}" loading="lazy">
          </div>
          <div class="design-card-footer">
            <span class="design-label">${d.label || ('Option ' + (i + 1))}</span>
            <span class="design-select-btn">Select</span>
          </div>
        `;
        grid.appendChild(card);
      });

      $('btn-order').disabled = true;
      $('pick-hint').textContent = 'Select a design above to continue';
    }

    function selectDesign(index) {
      STATE.selectedDesign = index;
      document.querySelectorAll('.design-card').forEach((c, i) => {
        c.classList.toggle('selected', i === index);
        c.querySelector('.design-select-btn').textContent = i === index ? 'Selected' : 'Select';
      });
      $('btn-order').disabled = false;
      $('pick-hint').textContent = '';
    }

    // --- Continue to order ---
    $('btn-order').addEventListener('click', () => {
      if (STATE.selectedDesign === null) return;
      const d = STATE.designs[STATE.selectedDesign];
      $('order-design-img').src = d.url;
      $('order-design-num').textContent = STATE.selectedDesign + 1;
      $('order-product-name').textContent = STATE.product?.name || 'Product';
      $('mockup-scene').className = `mockup-scene mockup-${STATE.product?.icon || 'custom'}`;
      goToStep('step-order');
    });

    document.querySelectorAll('input[name="fulfillmentType"]').forEach(input => input.addEventListener('change', () => {
      document.querySelectorAll('.fulfillment-card').forEach(card => card.classList.toggle('selected', card.contains(input)));
    }));

    // --- Submit order ---
    $('order-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = e.target.querySelector('.btn-submit');
      btn.querySelector('.btn-text').hidden = true;
      btn.querySelector('.btn-loading').hidden = false;
      btn.disabled = true;
      $('order-error').hidden = true;

      const formData = new FormData(e.target);

      try {
        const res = await fetch('/api/orders', {
          method: 'POST',
          body: JSON.stringify({
            userDescription: STATE.description,
            designs: STATE.designs,
            selectedDesign: STATE.selectedDesign,
            customerName: formData.get('customerName'),
            customerEmail: formData.get('customerEmail'),
            customerPhone: formData.get('customerPhone') || null,
            productType: $('productType').value,
            fulfillmentType: formData.get('fulfillmentType'),
            quantity: $('quantity').value,
          }),
          headers: { 'Content-Type': 'application/json' },
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Order failed');

        $('order-form').hidden = true;
        $('order-success').hidden = false;
        $('payment-next-message').textContent = data.paymentConfigured
          ? 'Your order is awaiting secure Sifalo Pay checkout. Production and downloads remain locked until payment is verified.'
          : 'Online payment is being configured. We saved your order, but production and downloads remain locked until payment is verified.';
        const orderLink = document.createElement('a');
        orderLink.className = 'btn-primary';
        orderLink.href = data.orderUrl;
        orderLink.textContent = data.paymentConfigured ? 'Open secure payment' : 'View order status';
        $('order-success').appendChild(orderLink);
      } catch (err) {
        $('order-error').textContent = err.message;
        $('order-error').hidden = false;
      } finally {
        btn.querySelector('.btn-text').hidden = false;
        btn.querySelector('.btn-loading').hidden = true;
        btn.disabled = false;
      }
    });

    // --- Back navigation ---
    document.querySelectorAll('.btn-back').forEach(btn => {
      btn.addEventListener('click', () => goToStep(btn.dataset.goto));
    });
  </script>
</body>
</html>
