<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Design Studio — SignPal</title>
  <link rel="icon" href="/images/signpal-logo-640.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700;800&family=DM+Sans:wght@300;400;500;700&family=Amiri:wght@400;700&family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/design.css">
</head>
<body>
  <%- include('partials/nav') %>

  <main class="design-main">
    <div class="design-container">

      <!-- Step Indicator Bar & Language Switcher -->
      <nav class="studio-stepper" aria-label="Studio Progress">
        <div class="stepper-track">
          <button type="button" class="step-node active" id="node-step-request" onclick="goToStep('step-request')">
            <span class="step-node-num">01</span>
            <span class="step-node-text" id="lbl-step-1">Configure & Brief</span>
          </button>
          <div class="stepper-line" id="line-1-2"></div>
          <button type="button" class="step-node" id="node-step-pick" onclick="STATE.designs.length > 0 && goToStep('step-pick')">
            <span class="step-node-num">02</span>
            <span class="step-node-text" id="lbl-step-2">Interactive Studio & Proof</span>
          </button>
          <div class="stepper-line" id="line-2-3"></div>
          <button type="button" class="step-node" id="node-step-order">
            <span class="step-node-num">03</span>
            <span class="step-node-text" id="lbl-step-3">Review & Sifalo Pay</span>
          </button>
        </div>
        <div class="lang-switch-wrap">
          <button type="button" class="lang-pill active" id="lang-btn-en" onclick="setStudioLanguage('en')">🇬🇧 EN</button>
          <button type="button" class="lang-pill" id="lang-btn-so" onclick="setStudioLanguage('so')">🇸🇴 SO</button>
        </div>
      </nav>

      <!-- ======================================================== -->
      <!-- STEP 1: CONFIGURE & BRIEF -->
      <!-- ======================================================== -->
      <section id="step-request" class="design-step active">
        <div class="step-header">
          <span class="step-badge">AI DESIGN MACHINE 2.0</span>
          <h1 class="step-title">Generate Production-Grade Print Designs in Seconds</h1>
          <p class="step-subtitle">No waiting 3 days for a busy designer. Select your product, pick an industry preset, and SignPal will synthesize 3 tailored, press-ready concepts with exact bleed margins.</p>
        </div>

        <form id="request-form" class="request-form">
          <fieldset class="entry-mode-picker">
            <legend>How would you like to begin?</legend>
            <label class="entry-mode active">
              <input type="radio" name="orderMode" value="create" checked>
              <span>
                <strong>✨ Synthesize with AI Design Machine</strong>
                <small>Get 3 distinct, photorealistic concepts in seconds</small>
              </span>
            </label>
            <label class="entry-mode">
              <input type="radio" name="orderMode" value="upload">
              <span>
                <strong>📤 Upload Finished Print Artwork</strong>
                <small>Have an existing PDF/AI file? Go straight to printing</small>
              </span>
            </label>
          </fieldset>

          <!-- Product Picker -->
          <div class="form-group product-picker-group">
            <div class="picker-head-row">
              <label for="product-search">Choose Print Product</label>
              <span class="market-advantage-pill">⚡ Guaranteed Best Wholesale Rates</span>
            </div>

            <div class="product-search-wrap">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
              <input id="product-search" type="search" placeholder="Search business cards, rollup banners, 3D signs, stickers, flyers…" autocomplete="off">
            </div>

            <input id="productType" name="productType" type="hidden" value="business_card">
            
            <div class="product-tabs" role="tablist" aria-label="Product categories">
              <% productCategories.forEach((category, index) => { %>
                <button type="button" class="product-tab <%= index === 0 ? 'active' : '' %>" data-category="<%= category.id %>"><%= category.name %></button>
              <% }) %>
            </div>

            <div id="product-grid" class="product-grid">
              <% products.forEach((product) => { %>
                <button type="button" class="product-card <%= product.id === 'business_card' ? 'selected' : '' %>" data-product-id="<%= product.id %>" data-product-name="<%= product.name.toLowerCase() %>" data-categories="<%= product.categories.join(' ') %>">
                  <span class="product-card-mark"><%= product.name.charAt(0) %></span>
                  <span class="product-card-copy"><strong><%= product.name %></strong><small><%= product.format %></small></span>
                  <span class="product-card-check">✓</span>
                </button>
              <% }) %>
            </div>
            <button id="show-all-products" type="button" class="btn-show-products">View all 45+ products</button>

            <div id="custom-product-fields" class="custom-product-fields" hidden>
              <div class="form-row">
                <div class="form-group"><label for="customProductName">Product name</label><input id="customProductName" type="text" placeholder="e.g. 3D Illuminated Pylon Signboard"></div>
                <div class="form-group"><label for="customProductSize">Approximate size</label><input id="customProductSize" type="text" placeholder="e.g. 4 m × 2 m"></div>
              </div>
              <div class="form-row">
                <div class="form-group"><label for="customProductQuantity">Quantity</label><input id="customProductQuantity" type="number" min="1" value="1"></div>
                <div class="form-group"><label for="customProductUse">Usage</label><select id="customProductUse"><option>Outdoor High-Durability</option><option>Indoor Display</option><option>Both</option></select></div>
              </div>
              <p class="custom-note">Custom signage & fabrication are reviewed before the final production run.</p>
            </div>

            <!-- Dynamic B2B Engineering & Fabrication Configurator -->
            <div id="b2b-configurator" class="b2b-config-box" hidden>
              <!-- 1. Architectural Signage Context -->
              <div id="cfg-signage" class="b2b-subconfig" hidden>
                <div class="b2b-header-row">
                  <span class="b2b-icon">💡</span>
                  <div>
                    <strong id="b2b-signage-title">Architectural Signage & Illumination Profile</strong>
                    <small id="b2b-signage-desc">Custom fabrication settings for 3D channel letters, lightboxes & totems</small>
                  </div>
                </div>
                <div class="b2b-options-row">
                  <div class="b2b-opt-group">
                    <label id="lbl-illumination">Illumination Style</label>
                    <div class="b2b-pills" id="pills-illumination">
                      <button type="button" class="b2b-pill active" data-group="illumination" data-value="Backlit LED Halo Glow">✨ Backlit Halo Glow</button>
                      <button type="button" class="b2b-pill" data-group="illumination" data-value="Frontlit Acrylic Face">💡 Frontlit Acrylic</button>
                      <button type="button" class="b2b-pill" data-group="illumination" data-value="Exposed Neon Flex">⚡ Neon Flex</button>
                      <button type="button" class="b2b-pill" data-group="illumination" data-value="Non-Illuminated 3D Matte">🏷️ Matte 3D (Non-lit)</button>
                    </div>
                  </div>
                  <div class="b2b-opt-group">
                    <label id="lbl-substrate">Mounting Facade Substrate</label>
                    <div class="b2b-pills" id="pills-substrate">
                      <button type="button" class="b2b-pill active" data-group="substrate" data-value="Dark Charcoal Alucobond Cladding">🏢 Alucobond Cladding</button>
                      <button type="button" class="b2b-pill" data-group="substrate" data-value="Polished Travertine Stone / Brick">🧱 Stone / Brick Facade</button>
                      <button type="button" class="b2b-pill" data-group="substrate" data-value="Tempered Glass Front">🪟 Glass Storefront</button>
                      <button type="button" class="b2b-pill" data-group="substrate" data-value="Free-standing Steel Totem">🗼 Roadside Pylon</button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- 2. Fleet & Vehicle / Bajaaj Wrap Context -->
              <div id="cfg-vehicle" class="b2b-subconfig" hidden>
                <div class="b2b-header-row">
                  <span class="b2b-icon">🚗</span>
                  <div>
                    <strong id="b2b-vehicle-title">Fleet & Vehicle Wrap Specification</strong>
                    <small id="b2b-vehicle-desc">Outdoor high-durability cast vinyl with UV lamination</small>
                  </div>
                </div>
                <div class="b2b-options-row">
                  <div class="b2b-opt-group">
                    <label id="lbl-vehicletype">Vehicle Model</label>
                    <div class="b2b-pills" id="pills-vehicletype">
                      <button type="button" class="b2b-pill active" data-group="vehicletype" data-value="Bajaaj / TVS King Auto-Rickshaw">🛺 Bajaaj / Rickshaw</button>
                      <button type="button" class="b2b-pill" data-group="vehicletype" data-value="Toyota Probox / Station Wagon">🚗 Commercial Car / Probox</button>
                      <button type="button" class="b2b-pill" data-group="vehicletype" data-value="Delivery Van / HiAce">🚐 Delivery Van / Bus</button>
                      <button type="button" class="b2b-pill" data-group="vehicletype" data-value="Pickup Truck / Land Cruiser">🛻 Pickup / 4x4 Fleet</button>
                    </div>
                  </div>
                  <div class="b2b-opt-group">
                    <label id="lbl-coverage">Wrap Coverage</label>
                    <div class="b2b-pills" id="pills-coverage">
                      <button type="button" class="b2b-pill active" data-group="coverage" data-value="Full 360° Commercial Vinyl Wrap">🛡️ Full 360° Wrap</button>
                      <button type="button" class="b2b-pill" data-group="coverage" data-value="Side Doors & Bonnet Branding">🚪 Side Doors + Hood</button>
                      <button type="button" class="b2b-pill" data-group="coverage" data-value="Rear Window One-Way Vision">🪟 Perforated Rear Glass</button>
                      <button type="button" class="b2b-pill" data-group="coverage" data-value="Die-Cut Brand Decal Kit">✂️ Die-Cut Decals</button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- 3. Corporate Identity Suite Context -->
              <div id="cfg-corporate" class="b2b-subconfig" hidden>
                <div class="b2b-header-row">
                  <span class="b2b-icon">📁</span>
                  <div>
                    <strong id="b2b-corporate-title">Complete Corporate Identity Suite</strong>
                    <small id="b2b-corporate-desc">Synchronized 4-item branding package ready for press & distribution</small>
                  </div>
                </div>
                <div class="bundle-manifest-grid">
                  <div class="bundle-item-card">
                    <span class="bundle-item-qty">100×</span>
                    <div class="bundle-item-info">
                      <strong>Business Cards</strong>
                      <small>85×55mm · Soft-touch 400gsm</small>
                    </div>
                  </div>
                  <div class="bundle-item-card">
                    <span class="bundle-item-qty">100×</span>
                    <div class="bundle-item-info">
                      <strong>A4 Letterheads</strong>
                      <small>210×297mm · Premium 120gsm</small>
                    </div>
                  </div>
                  <div class="bundle-item-card">
                    <span class="bundle-item-qty">10×</span>
                    <div class="bundle-item-info">
                      <strong>Employee Badges</strong>
                      <small>CR80 PVC + Branded Lanyards</small>
                    </div>
                  </div>
                  <div class="bundle-item-card">
                    <span class="bundle-item-qty">1×</span>
                    <div class="bundle-item-info">
                      <strong>Rollup Banner</strong>
                      <small>800×2000mm Aluminum Stand</small>
                    </div>
                  </div>
                </div>
                <div class="bundle-price-advantage">
                  <span>Total Individual Value: <del>$135</del></span>
                  <span class="bundle-badge">⚡ SignPal Bundle Price: <strong>$85.50</strong> (Save $49.50)</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Smart Somali Industry Presets -->
          <div class="form-group preset-group" id="industry-preset-group">
            <label>Industry Preset <span class="label-optional">(Tunes layout, hierarchy & aesthetic norms)</span></label>
            <div class="preset-pills">
              <button type="button" class="preset-pill active" data-industry="Corporate & Tech">💼 Corporate & Tech</button>
              <button type="button" class="preset-pill" data-industry="Café & Restaurant">☕ Café & Food</button>
              <button type="button" class="preset-pill" data-industry="Construction & Real Estate">🏗️ Construction & Property</button>
              <button type="button" class="preset-pill" data-industry="Health & Clinic">🏥 Clinic & Pharmacy</button>
              <button type="button" class="preset-pill" data-industry="Retail & Fashion">🛍️ Retail & Fashion</button>
              <button type="button" class="preset-pill" data-industry="NGO & Education">🎓 NGO & Education</button>
            </div>
            <input type="hidden" id="industryInput" name="industry" value="Corporate & Tech">
          </div>

          <!-- Aesthetic Style Presets -->
          <div class="form-group style-preset-group" id="style-preset-group">
            <label>Visual Style Direction</label>
            <div class="style-cards-grid">
              <label class="style-preset-card active">
                <input type="radio" name="stylePreset" value="Luxury Gold Foil & Obsidian Dark" checked>
                <div class="style-card-badge">PREMIUM</div>
                <strong>✨ Luxury & Dark Obsidian</strong>
                <small>Deep textured blacks, gold metallic accents, high-end prestige</small>
              </label>
              <label class="style-preset-card">
                <input type="radio" name="stylePreset" value="Bold Dynamic & Modern">
                <div class="style-card-badge">VIBRANT</div>
                <strong>⚡ Bold & Vibrant</strong>
                <small>High impact contrast, bold headlines, geometric framing</small>
              </label>
              <label class="style-preset-card">
                <input type="radio" name="stylePreset" value="Clean Minimalist Grid">
                <div class="style-card-badge">CLEAN</div>
                <strong>📐 Clean Minimalist</strong>
                <small>Balanced negative space, Swiss grid discipline, modern clarity</small>
              </label>
              <label class="style-preset-card">
                <input type="radio" name="stylePreset" value="Traditional Heritage & Calligraphy">
                <div class="style-card-badge">CLASSIC</div>
                <strong>🏛️ Classic Calligraphic</strong>
                <small>Ornate framing borders, refined typography, cultural prestige</small>
              </label>
            </div>
          </div>

          <!-- Quick Fill Sample Briefs -->
          <div class="quick-fill-bar">
            <span class="quick-fill-label">⚡ 1-Click Samples:</span>
            <button type="button" class="quick-fill-btn" data-fill="growmedia">Grow Media (Agency)</button>
            <button type="button" class="quick-fill-btn" data-fill="hambalcafe">Hambal Roastery (Café)</button>
            <button type="button" class="quick-fill-btn" data-fill="dhismahaconst">Hargeisa Heights (Property)</button>
            <button type="button" class="quick-fill-btn" data-fill="dahabshiilsign">Dahabshiil (3D Sign)</button>
            <button type="button" class="quick-fill-btn" data-fill="bajaajdelivery">Bajaaj Express (Fleet Wrap)</button>
            <button type="button" class="quick-fill-btn" data-fill="horntelecom">Horn Telecom (Brand Suite)</button>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="languages">Language & Script Preservation</label>
              <select id="languages" name="languages" class="form-select">
                <option value="English + Somali" selected>English + Somali (Bi-lingual)</option>
                <option value="English + Arabic">English + Arabic (Calligraphic)</option>
                <option value="Somali + Arabic">Somali + Arabic</option>
                <option value="English Only">English Only</option>
                <option value="Somali Only">Somali Only</option>
              </select>
            </div>
            <div class="form-group">
              <label for="quantity">Order Quantity</label>
              <input id="quantity" name="quantity" type="number" min="1" value="100">
            </div>
          </div>

          <!-- Dynamic Pricing Snapshot -->
          <div id="price-estimate" class="price-estimate">
            <div class="price-left">
              <span>Dynamic Factory Quotation</span>
              <strong id="price-estimate-amount">Calculating…</strong>
            </div>
            <div class="price-right">
              <span class="savings-tag">Direct Factory Wholesale Rates</span>
              <small id="price-estimate-note">Exact SignPal direct factory price with minimum-margin guarantee.</small>
            </div>
          </div>

          <div class="form-group">
            <label for="brandId">Brand DNA Profile <span class="label-optional">(Optional — locks brand hex colors & fonts)</span></label>
            <select id="brandId" name="brandId" class="form-select">
              <option value="">No Brand Selected (New Design)</option>
            </select>
          </div>

          <div class="form-group">
            <label for="description">Design Description & Content Details</label>
            <textarea id="description" name="description" rows="5" placeholder="e.g. Business card for Mustafe Ibrahim Ahmed, Founder of Grow Media. Tagline: Premium Digital Printing & Signage. Phone: +252 63 4226437, Email: info@growmedia.so, Location: Airport Road, Hargeisa, Somaliland." maxlength="1000" required></textarea>
            <div class="desc-footer">
              <span class="char-count"><span id="char-count">0</span>/1000 characters</span>
            </div>
          </div>

          <div class="form-group">
            <label id="upload-label">Inspiration or Reference Images <span class="label-optional">(Optional, up to 3)</span></label>
            <div class="upload-area" id="upload-area">
              <input type="file" id="file-input" name="images" accept="image/*" multiple hidden>
              <div class="upload-placeholder" id="upload-placeholder">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
                </svg>
                <p>Drop references or logo here or <span class="upload-link">click to browse</span></p>
                <p class="upload-hint">PNG, JPG, WEBP — up to 3 files</p>
              </div>
              <div class="upload-previews" id="upload-previews"></div>
            </div>
          </div>

          <!-- Generation Telemetry HUD (Shown when generating) -->
          <div id="telemetry-hud" class="telemetry-hud" hidden>
            <div class="telemetry-header">
              <span class="telemetry-pulse"></span>
              <span class="telemetry-title">SYNTHESIZING DESIGN MACHINE CONCEPTS</span>
            </div>
            <div class="telemetry-steps">
              <div class="telemetry-step active" id="telem-step-1">
                <div class="telem-indicator">1</div>
                <div class="telem-info">
                  <strong>Brand Brief & Content Extraction</strong>
                  <span>Structuring color roles, typography pairings & verified text…</span>
                </div>
              </div>
              <div class="telemetry-step" id="telem-step-2">
                <div class="telem-indicator">2</div>
                <div class="telem-info">
                  <strong>3-Direction Layout Generation</strong>
                  <span>Synthesizing Concept A (Grid), Concept B (Editorial), Concept C (Emblem)…</span>
                </div>
              </div>
              <div class="telemetry-step" id="telem-step-3">
                <div class="telem-indicator">3</div>
                <div class="telem-info">
                  <strong>Pre-Flight Quality & Bleed Audit</strong>
                  <span>Validating 300 DPI resolution, Fogra39 CMYK & safety margins…</span>
                </div>
              </div>
            </div>
          </div>

          <button type="submit" class="btn-generate" id="btn-submit-generate">
            <span class="btn-text">⚡ Synthesize My 3 Concepts</span>
            <span class="btn-loading" hidden>
              <svg class="spinner" viewBox="0 0 24 24" width="20" height="20">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="30 70" stroke-linecap="round"/>
              </svg>
              Synthesizing designs...
            </span>
          </button>
        </form>

        <div id="request-error" class="error-msg" hidden></div>
      </section>

      <!-- ======================================================== -->
      <!-- STEP 2: INTERACTIVE STUDIO & PROOF INSPECTOR -->
      <!-- ======================================================== -->
      <section id="step-pick" class="design-step">
        <div class="studio-header">
          <div>
            <span class="step-badge">INTERACTIVE PROOF STUDIO</span>
            <h1 class="step-title">Inspect, Tweak & Select Your Concept</h1>
            <p class="step-subtitle">Toggle between 3D Real-World Presentation and 2D Print Production view. Edit text fields in real-time with zero typos!</p>
          </div>
          <button type="button" class="btn-back" data-goto="step-request">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
            Adjust Description or Preset
          </button>
        </div>

        <!-- Studio Control Bar -->
        <div class="studio-controls-bar">
          <div class="studio-view-toggle">
            <span class="view-toggle-label">Viewport Mode:</span>
            <div class="toggle-pill-group">
              <button type="button" class="toggle-pill active" id="view-mode-mockup" onclick="setStudioViewMode('mockup')">
                🌐 3D Showcase Mockup
              </button>
              <button type="button" class="toggle-pill" id="view-mode-flat" onclick="setStudioViewMode('flat')">
                📐 2D Print Production Canvas (Bleed & Crop)
              </button>
            </div>
          </div>

          <div class="studio-actions-group" style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
            <div class="studio-overlay-toggle">
              <label class="switch-control">
                <input type="checkbox" id="toggle-text-overlay" checked onchange="toggleVectorOverlay(this.checked)">
                <span class="switch-slider"></span>
                <span class="switch-label" id="lbl-toggle-overlay">Live Typo-Proof Text Overlay</span>
              </label>
            </div>

            <button type="button" class="btn-wa-header-share" onclick="shareConceptOnWhatsApp()">
              📲 Share Concept on WhatsApp
            </button>
          </div>
        </div>

        <!-- Main Studio Grid -->
        <div class="studio-workspace">
          <!-- Concepts Column -->
          <div class="studio-concepts-col">
            <div id="designs-grid" class="studio-concepts-grid"></div>
          </div>

          <!-- Studio Inspector & Live Editor Column -->
          <aside class="studio-sidebar">
            
            <!-- Live In-Browser Typography & Contact Overlay Editor -->
            <div class="studio-panel live-editor-panel">
              <div class="panel-head">
                <div class="panel-icon">✏️</div>
                <div>
                  <h3>Live Content & Text Overlay</h3>
                  <p>Updates instantly on canvas — zero typos guaranteed</p>
                </div>
              </div>

              <div class="editor-fields">
                <div class="editor-field">
                  <label for="overlay-name">Business / Personal Name</label>
                  <input type="text" id="overlay-name" placeholder="e.g. Grow Media" oninput="updateLiveOverlay()">
                </div>
                <div class="editor-field">
                  <label for="overlay-tagline">Tagline / Services</label>
                  <input type="text" id="overlay-tagline" placeholder="e.g. Digital Printing & Signage" oninput="updateLiveOverlay()">
                </div>
                <div class="editor-row">
                  <div class="editor-field">
                    <label for="overlay-phone">Phone Number</label>
                    <input type="text" id="overlay-phone" placeholder="e.g. +252 63 4226437" oninput="updateLiveOverlay()">
                  </div>
                  <div class="editor-field">
                    <label for="overlay-email">Email / Website</label>
                    <input type="text" id="overlay-email" placeholder="e.g. info@growmedia.so" oninput="updateLiveOverlay()">
                  </div>
                </div>
                <div class="editor-field">
                  <label for="overlay-location">Address / City</label>
                  <input type="text" id="overlay-location" placeholder="e.g. Airport Road, Hargeisa, Somaliland" oninput="updateLiveOverlay()">
                </div>
                <div class="editor-row">
                  <div class="editor-field">
                    <label for="overlay-accent">Accent Color</label>
                    <div class="color-picker-wrap">
                      <input type="color" id="overlay-accent" value="#fe6a00" onchange="updateLiveOverlay()">
                      <span id="overlay-accent-val">#FE6A00</span>
                    </div>
                  </div>
                  <div class="editor-field">
                    <label for="overlay-font">Typography Pairing</label>
                    <select id="overlay-font" onchange="updateLiveOverlay()">
                      <option value="Sora, sans-serif">Sora + DM Sans</option>
                      <option value="'Montserrat', sans-serif">Montserrat + Inter</option>
                      <option value="'Cairo', sans-serif">Cairo (Arabic / Modern)</option>
                      <option value="'Amiri', serif">Amiri (Arabic / Calligraphic)</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>

            <!-- Pre-Flight Production Health Card -->
            <div class="studio-panel preflight-panel">
              <div class="panel-head">
                <div class="panel-icon">🛡️</div>
                <div>
                  <h3>Pre-Flight Production Auditor</h3>
                  <p>Certified factory press readiness</p>
                </div>
                <span class="preflight-score-badge" id="preflight-score-badge">94 / 100</span>
              </div>

              <div class="preflight-checklist" id="preflight-checklist">
                <div class="check-item pass">
                  <span class="check-icon">✓</span>
                  <div class="check-copy">
                    <strong>Typography Contrast Ratio</strong>
                    <small>WCAG AAA (8.4:1) certified high-contrast legibility</small>
                  </div>
                </div>
                <div class="check-item pass">
                  <span class="check-icon">✓</span>
                  <div class="check-copy">
                    <strong id="preflight-bleed-title">Bleed & Safe Zone (3mm Margin)</strong>
                    <small>Inner cut safety line protected from trimming variance</small>
                  </div>
                </div>
                <div class="check-item pass">
                  <span class="check-icon">✓</span>
                  <div class="check-copy">
                    <strong id="preflight-dpi-title">Physical Resolution (300 DPI)</strong>
                    <small>High-density pixels verified for physical production</small>
                  </div>
                </div>
                <div class="check-item pass">
                  <span class="check-icon">✓</span>
                  <div class="check-copy">
                    <strong>CMYK Gamut Separation</strong>
                    <small>Standard Fogra39 profile — zero out-of-gamut clipping</small>
                  </div>
                </div>
              </div>
            </div>

            <!-- Order Confirmation Card -->
            <div class="studio-panel order-cta-panel">
              <div class="order-summary-box">
                <div class="summary-line">
                  <span id="summary-product-name">Business Cards</span>
                  <strong id="summary-quantity">100 pcs</strong>
                </div>
                <div class="summary-line highlight">
                  <span>SignPal Direct Price</span>
                  <strong id="summary-price">$18.00</strong>
                </div>
                <div class="summary-savings">
                  ⚡ Direct commercial wholesale pricing. Free high-res AI design included.
                </div>
              </div>

              <button type="button" class="btn-primary btn-studio-order" id="btn-order" disabled>
                Continue to Order with Selected Concept →
              </button>
              <p id="pick-hint" class="pick-hint">Select a design concept on the left to proceed</p>
            </div>

          </aside>
        </div>
      </section>

      <!-- ======================================================== -->
      <!-- STEP 3: SUBMIT ORDER & SIFALO PAY -->
      <!-- ======================================================== -->
      <section id="step-order" class="design-step">
        <div class="step-header">
          <span class="step-badge">STEP 03 · COMMERCE & CHECKOUT</span>
          <h1 class="step-title">Review & Submit Your Order</h1>
          <p class="step-subtitle">Your selected design is queued for print production. Pay easily with mobile money (Zaad, eDahab, EVC Plus).</p>
          <button type="button" class="btn-back" data-goto="step-pick">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 5l-7 7 7 7"/>
            </svg>
            Back to Studio Inspector
          </button>
        </div>

        <div class="order-selected mockup-stage" id="mockup-stage">
          <div class="mockup-scene" id="mockup-scene">
            <div class="mockup-viewport" id="order-mockup-viewport">
              <img id="order-design-img" src="" alt="Selected design">
              <div class="canvas-overlay-content" id="order-overlay-content"></div>
            </div>
          </div>
          <div class="order-design-label">
            <span class="design-num"><span id="order-product-name">Product</span> · Concept <span id="order-design-num">1</span></span>
            <span class="verified-tag">✓ Pre-Flight Passed</span>
          </div>
        </div>

        <form id="order-form" class="order-form">
          <fieldset class="fulfillment-picker">
            <legend>What would you like to do?</legend>
            <label class="fulfillment-card selected">
              <input type="radio" name="fulfillmentType" value="print" checked>
              <span>
                <strong>Print & Deliver with SignPal</strong>
                <small>High-resolution design is 100% FREE. You only pay for local production & delivery.</small>
              </span>
              <b>Best Value</b>
            </label>
            <label class="fulfillment-card">
              <input type="radio" name="fulfillmentType" value="download">
              <span>
                <strong>Download Production Files Only</strong>
                <small>Pay $15 design fee to download 300 DPI upscaled flat files with bleed & crop marks.</small>
              </span>
            </label>
          </fieldset>

          <div class="form-row">
            <div class="form-group">
              <label for="customerName">Your Full Name</label>
              <input type="text" id="customerName" name="customerName" placeholder="e.g. Ali Mohamed Hassan" required>
            </div>
            <div class="form-group">
              <label for="customerEmail">Email Address</label>
              <input type="email" id="customerEmail" name="customerEmail" placeholder="ali@example.com" required>
            </div>
          </div>

          <div class="form-group">
            <label for="customerPhone">Mobile Money Number <span class="label-optional">(Zaad, eDahab, EVC Plus for 1-tap checkout)</span></label>
            <input type="tel" id="customerPhone" name="customerPhone" placeholder="+252 63 422 6437">
          </div>

          <button type="submit" class="btn-primary btn-submit">
            <span class="btn-text">Lock In Order & Proceed to Sifalo Pay</span>
            <span class="btn-loading" hidden>
              <svg class="spinner" viewBox="0 0 24 24" width="20" height="20">
                <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="30 70" stroke-linecap="round"/>
              </svg>
              Submitting order...
            </span>
          </button>
        </form>

        <div id="order-success" class="success-panel" hidden>
          <div class="success-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 6L9 17l-5-5"/>
            </svg>
          </div>
          <h2>Order Successfully Saved!</h2>
          <p id="payment-next-message">Your order has been recorded. Click below to complete mobile money payment via Sifalo Pay.</p>
        </div>

        <div id="order-error" class="error-msg" hidden></div>
      </section>

    </div>
  </main>

  <!-- Fullscreen High-Resolution Lightbox / Zoom Inspector -->
  <div id="lightbox-modal" class="lightbox-modal" hidden onclick="closeLightbox(event)">
    <div class="lightbox-content">
      <button type="button" class="lightbox-close" onclick="closeLightbox()">&times;</button>
      <div class="lightbox-viewport" id="lightbox-viewport">
        <img id="lightbox-img" src="" alt="Full Resolution Inspection">
        <div class="canvas-overlay-content" id="lightbox-overlay"></div>
      </div>
      <div class="lightbox-footer">
        <span id="lightbox-label">Concept Inspection</span>
        <span class="lightbox-dpi">300 DPI Super-Resolution Mode</span>
      </div>
    </div>
  </div>

  <script>
    const STATE = {
      description: null,
      images: [],
      designs: [],
      selectedDesign: null,
      loadingDesigns: false,
      product: null,
      brief: null,
      printSpec: null,
      preflight: null,
      viewMode: 'mockup', // 'mockup' | 'flat'
      showOverlay: true,
      overlayData: {
        name: '',
        tagline: '',
        phone: '',
        email: '',
        location: '',
        accent: '#fe6a00',
        font: 'Sora, sans-serif'
      }
    };

    function $(id) {
      return document.getElementById(id) || {
        textContent: '',
        value: '',
        style: {},
        classList: { add() {}, remove() {}, toggle() {} },
        hidden: false,
        addEventListener() {}
      };
    }

    const productSearch = $('product-search');
    const productCards = [...document.querySelectorAll('.product-card')];
    const PRODUCT_MINIMUMS = { business_card: 100, brochure: 20, flyer: 20, letterhead: 100, envelope: 100, sticker: 12, product_label: 12 };
    let activeProductCategory = 'popular';

    // --- Stepper Navigation ---
    function goToStep(stepId) {
      document.querySelectorAll('.design-step').forEach(s => s.classList.remove('active'));
      $(stepId).classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });

      // Update stepper nodes
      const nodes = ['step-request', 'step-pick', 'step-order'];
      const activeIdx = nodes.indexOf(stepId);
      nodes.forEach((id, idx) => {
        const node = $(`node-${id}`);
        if (node) {
          node.classList.toggle('active', idx === activeIdx);
          node.classList.toggle('completed', idx < activeIdx);
        }
      });
      if ($('line-1-2')) $('line-1-2').classList.toggle('active', activeIdx >= 1);
      if ($('line-2-3')) $('line-2-3').classList.toggle('active', activeIdx >= 2);
    }

    // --- Product Filtering & Selection ---
    function filterProducts() {
      const query = productSearch.value.trim().toLowerCase();
      productCards.forEach(card => {
        const matchesSearch = !query || card.dataset.productName.includes(query);
        const matchesCategory = query || activeProductCategory === 'all' || card.dataset.categories.split(' ').includes(activeProductCategory);
        card.hidden = !(matchesSearch && matchesCategory);
      });
    }

    productCards.forEach(card => card.addEventListener('click', () => {
      productCards.forEach(item => item.classList.remove('selected'));
      card.classList.add('selected');
      const pid = card.dataset.productId;
      $('productType').value = pid;
      $('quantity').value = PRODUCT_MINIMUMS[pid] || 1;
      $('custom-product-fields').hidden = pid !== 'custom';

      // Dynamic B2B Engineering & Fabrication Configurator visibility
      const isSignage = ['shop_sign', 'three_d_letters', 'illuminated_sign', 'neon_sign', 'acrylic_sign', 'pylon_sign', 'cladding_sign', 'directional_sign'].includes(pid);
      const isVehicle = ['bajaaj_wrap', 'vehicle_wrap', 'vehicle_decal'].includes(pid);
      const isCorporate = pid === 'corporate_bundle';

      const b2bBox = $('b2b-configurator');
      if (b2bBox) {
        b2bBox.hidden = !(isSignage || isVehicle || isCorporate);
        $('cfg-signage').hidden = !isSignage;
        $('cfg-vehicle').hidden = !isVehicle;
        $('cfg-corporate').hidden = !isCorporate;
      }

      refreshPriceEstimate();
    }));

    // B2B Configurator Pill Selection
    document.querySelectorAll('.b2b-pill').forEach(pill => {
      pill.addEventListener('click', () => {
        const group = pill.dataset.group;
        document.querySelectorAll(`.b2b-pill[data-group="${group}"]`).forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
      });
    });

    document.querySelectorAll('.product-tab').forEach(tab => tab.addEventListener('click', () => {
      document.querySelectorAll('.product-tab').forEach(item => item.classList.remove('active'));
      tab.classList.add('active');
      activeProductCategory = tab.dataset.category;
      productSearch.value = '';
      filterProducts();
    }));

    productSearch.addEventListener('input', filterProducts);
    $('show-all-products').addEventListener('click', () => {
      activeProductCategory = 'all';
      document.querySelectorAll('.product-tab').forEach(item => item.classList.remove('active'));
      productSearch.value = '';
      filterProducts();
      $('show-all-products').hidden = true;
    });
    filterProducts();

    // Industry Presets
    document.querySelectorAll('.preset-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.preset-pill').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        $('industryInput').value = btn.dataset.industry;
      });
    });

    // Style Presets
    document.querySelectorAll('.style-preset-card').forEach(card => {
      card.addEventListener('click', () => {
        document.querySelectorAll('.style-preset-card').forEach(c => c.classList.remove('active'));
        card.classList.add('active');
      });
    });

    // Quick Fill Samples
    const SAMPLES = {
      growmedia: {
        product: 'business_card',
        industry: 'Corporate & Tech',
        desc: 'Business card for Mustafe Ibrahim Ahmed, Founder & Director of Grow Media. Tagline: Premium Digital Printing, Signage & Visual Branding. Phone: +252 63 4226437. Email: mustafe@growmedia.so. Location: Airport Road, Hargeisa, Somaliland.',
        qty: 100
      },
      hambalcafe: {
        product: 'rollup_banner',
        industry: 'Café & Restaurant',
        desc: 'Roll-up banner for Hambal Specialty Coffee Roasters. Tagline: Single-origin Ethiopian and Harar beans roasted locally in Hargeisa. Serving artisan espresso, v60 pour-overs, and fresh pastries. Order hotline: +252 63 4567890. Downtown Branch, Hargeisa.',
        qty: 2
      },
      dhismahaconst: {
        product: 'shop_sign',
        industry: 'Construction & Real Estate',
        desc: 'Shop storefront signboard for Hargeisa Heights Contracting & Construction. Specializing in commercial high-rises, road engineering, and architectural steel structures. Phone: +252 63 7891234. Jigjiga Yar, Hargeisa.',
        qty: 1
      },
      dahabshiilsign: {
        product: 'three_d_letters',
        industry: 'Corporate & Tech',
        desc: '3D Illuminated Channel Letter Signboard for Dahabshiil Branch. Tagline: Fast & Reliable Remittance and Banking Services. Backlit LED halo glow mounted on dark charcoal alucobond cladding. Phone: +252 63 500000. Downtown Square, Hargeisa.',
        qty: 1
      },
      bajaajdelivery: {
        product: 'bajaaj_wrap',
        industry: 'Retail & Fashion',
        desc: 'Full 360-degree commercial vinyl wrap for Bajaaj Express Delivery Fleet. Vibrant emerald green and gold branding with courier parcel graphics. Slogan: Gaadhsiin Degdeg Ah oo Hargeisa Oo Dhan ah. Customer Hotline: +252 63 4443322.',
        qty: 1
      },
      horntelecom: {
        product: 'corporate_bundle',
        industry: 'Corporate & Tech',
        desc: 'Corporate Identity Suite for Horn Connect Fiber & 5G Telecom. Includes matching executive business cards, official A4 letterheads, staff CR80 smart badges with branded lanyards, and high-impact rollup banner. Colors: Electric Blue, Gold and Obsidian Black. Phone: +252 63 909090. Info: contact@hornconnect.so.',
        qty: 1
      }
    };

    document.querySelectorAll('.quick-fill-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.fill;
        const sample = SAMPLES[key];
        if (!sample) return;

        $('description').value = sample.desc;
        $('char-count').textContent = sample.desc.length;
        $('quantity').value = sample.qty;

        // Set industry
        document.querySelectorAll('.preset-pill').forEach(p => {
          if (p.dataset.industry === sample.industry) p.click();
        });

        // Set product
        const card = productCards.find(c => c.dataset.productId === sample.product);
        if (card) {
          activeProductCategory = 'all';
          filterProducts();
          card.click();
        }
        refreshPriceEstimate();
      });
    });

    // Pricing Refresh
    let priceEstimateTimer;
    async function refreshPriceEstimate() {
      clearTimeout(priceEstimateTimer);
      priceEstimateTimer = setTimeout(async () => {
        try {
          const query = new URLSearchParams({ productType: $('productType').value, quantity: $('quantity').value || '1' });
          const res = await fetch(`/api/pricing/estimate?${query}`);
          const estimate = await res.json();
          if (estimate.available) {
            const currency = estimate.mode === 'approved' ? '$' : '';
            $('price-estimate-amount').textContent = `${currency}${Number(estimate.total).toFixed(2)} · ${currency}${Number(estimate.unitPrice).toFixed(2)} / ${estimate.unit}`;
            $('price-estimate-note').textContent = estimate.quoteRequired
              ? 'Provisional estimate. Confirmed before payment.'
              : 'Exact SignPal direct factory price with quality guarantee.';
            
            // Sidebar summary updates
            $('summary-price').textContent = `${currency}${Number(estimate.total).toFixed(2)}`;
            $('summary-quantity').textContent = `${estimate.quantity} ${estimate.unit}(s)`;
          } else {
            $('price-estimate-amount').textContent = 'Custom Quotation Required';
            $('price-estimate-note').textContent = estimate.reason || 'Factory specifications confirmed on review.';
            $('summary-price').textContent = 'Custom Quote';
          }
        } catch (_) {
          $('price-estimate-amount').textContent = 'Estimate Temporarily Unavailable';
        }
      }, 150);
    }
    $('quantity').addEventListener('input', refreshPriceEstimate);
    refreshPriceEstimate();

    // Entry Mode
    function setOrderMode(mode) {
      document.querySelectorAll('.entry-mode').forEach(label => label.classList.toggle('active', label.querySelector('input').value === mode));
      $('upload-label').innerHTML = mode === 'upload'
        ? 'Finished artwork <span class="label-optional">(required, PDF, AI, or High-Res Image)</span>'
        : 'Inspiration or Reference Images <span class="label-optional">(optional, up to 3)</span>';
      $('btn-submit-generate').querySelector('.btn-text').textContent = mode === 'upload' ? '📤 Continue with Uploaded Artwork' : '⚡ Synthesize My 3 Concepts';
      $('industry-preset-group').hidden = mode === 'upload';
      $('style-preset-group').hidden = mode === 'upload';
    }
    document.querySelectorAll('input[name="orderMode"]').forEach(input => input.addEventListener('change', () => setOrderMode(input.value)));

    // File Upload Handling
    const fileInput = $('file-input');
    const uploadArea = $('upload-area');
    const uploadPlaceholder = $('upload-placeholder');
    const uploadPreviews = $('upload-previews');

    function renderPreviews() {
      uploadPreviews.innerHTML = '';
      if (STATE.images.length === 0) {
        uploadPlaceholder.style.display = '';
        return;
      }
      uploadPlaceholder.style.display = 'none';

      STATE.images.forEach((file, i) => {
        const div = document.createElement('div');
        div.className = 'preview-item';
        const reader = new FileReader();
        reader.onload = (e) => {
          div.innerHTML = `
            <img src="${e.target.result}" alt="Preview ${i + 1}">
            <button type="button" class="preview-remove" data-index="${i}">&times;</button>
          `;
          div.querySelector('.preview-remove').addEventListener('click', (ev) => {
            ev.stopPropagation();
            STATE.images.splice(i, 1);
            renderPreviews();
          });
        };
        reader.readAsDataURL(file);
        uploadPreviews.appendChild(div);
      });

      if (STATE.images.length < 3) {
        const addMore = document.createElement('div');
        addMore.className = 'preview-add-more';
        addMore.innerHTML = `<button type="button">+ Add</button>`;
        uploadPreviews.appendChild(addMore);
        addMore.querySelector('button').addEventListener('click', () => fileInput.click());
      }
    }

    uploadArea.addEventListener('click', () => fileInput.click());
    uploadArea.addEventListener('dragover', (e) => { e.preventDefault(); uploadArea.classList.add('drag-over'); });
    uploadArea.addEventListener('dragleave', () => uploadArea.classList.remove('drag-over'));
    uploadArea.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadArea.classList.remove('drag-over');
      for (const f of e.dataTransfer.files) {
        if (STATE.images.length >= 3) break;
        if (f.type.startsWith('image/')) STATE.images.push(f);
      }
      renderPreviews();
    });

    fileInput.addEventListener('change', (e) => {
      for (const f of e.target.files) {
        if (STATE.images.length >= 3) break;
        if (f.type.startsWith('image/')) STATE.images.push(f);
      }
      fileInput.value = '';
      renderPreviews();
    });

    // Brand profiles
    async function loadBrandProfiles() {
      try {
        const res = await fetch('/api/brands');
        if (!res.ok) return;
        const { brands } = await res.json();
        const select = $('brandId');
        if (select && brands && brands.length > 0) {
          select.innerHTML = '<option value="">No Brand Selected (New Design)</option>' +
            brands.map(b => `<option value="${b.id}">${b.name} (${b.industry || 'Brand Profile'})</option>`).join('');
        }
      } catch (_) {}
    }
    loadBrandProfiles();

    $('description').addEventListener('input', (e) => {
      $('char-count').textContent = e.target.value.length;
    });

    // --- Submit Request & Run Telemetry HUD ---
    $('request-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      let description = $('description').value.trim();
      if (!description) return;
      const orderMode = new FormData(e.target).get('orderMode') || 'create';

      if (orderMode === 'upload' && STATE.images.length === 0) {
        $('request-error').textContent = 'Please upload your finished artwork before continuing.';
        $('request-error').hidden = false;
        $('upload-area').scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }

      const productType = $('productType')?.value || 'business_card';
      const languages = $('languages')?.value || 'English + Somali';
      const brandId = $('brandId')?.value || '';
      const industry = $('industryInput')?.value || 'Corporate & Tech';
      const stylePreset = document.querySelector('input[name="stylePreset"]:checked')?.value || 'Luxury Gold Foil & Obsidian Dark';

      // Contextual B2B Engineering & Fabrication Enrichment
      const isSignage = ['shop_sign', 'three_d_letters', 'illuminated_sign', 'neon_sign', 'acrylic_sign', 'pylon_sign', 'cladding_sign', 'directional_sign'].includes(productType);
      const isVehicle = ['bajaaj_wrap', 'vehicle_wrap', 'vehicle_decal'].includes(productType);
      const isCorporate = productType === 'corporate_bundle';

      if (isSignage) {
        const ill = document.querySelector('.b2b-pill.active[data-group="illumination"]')?.dataset.value;
        const sub = document.querySelector('.b2b-pill.active[data-group="substrate"]')?.dataset.value;
        if (ill && !description.includes(ill)) description += ` [Illumination: ${ill}]`;
        if (sub && !description.includes(sub)) description += ` [Mounting Substrate: ${sub}]`;
      } else if (isVehicle) {
        const vtype = document.querySelector('.b2b-pill.active[data-group="vehicletype"]')?.dataset.value;
        const cov = document.querySelector('.b2b-pill.active[data-group="coverage"]')?.dataset.value;
        if (vtype && !description.includes(vtype)) description += ` [Vehicle Model: ${vtype}]`;
        if (cov && !description.includes(cov)) description += ` [Wrap Coverage: ${cov}]`;
      } else if (isCorporate) {
        if (!description.includes('Corporate Identity Bundle')) {
          description += ` [Corporate Identity Bundle: 100x Business Cards, 100x A4 Letterheads, 10x Staff Badges with Lanyards, 1x Rollup Banner]`;
        }
      }

      STATE.description = description;
      STATE.designs = [];
      STATE.selectedDesign = null;

      const btn = $('btn-submit-generate');
      btn.querySelector('.btn-text').hidden = true;
      btn.querySelector('.btn-loading').hidden = false;
      btn.disabled = true;
      $('request-error').hidden = true;

      // Show Telemetry HUD
      const telem = $('telemetry-hud');
      telem.hidden = false;
      telem.scrollIntoView({ behavior: 'smooth', block: 'center' });

      // Animate telemetry stages
      const telemTimer1 = setTimeout(() => {
        $('telem-step-1').classList.remove('active');
        $('telem-step-1').classList.add('completed');
        $('telem-step-2').classList.add('active');
      }, 2500);

      const telemTimer2 = setTimeout(() => {
        $('telem-step-2').classList.remove('active');
        $('telem-step-2').classList.add('completed');
        $('telem-step-3').classList.add('active');
      }, 7000);

      try {
        const imageDataUrls = await Promise.all(
          STATE.images.map(f => new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = ev => resolve(ev.target.result);
            reader.onerror = reject;
            reader.readAsDataURL(f);
          }))
        );

        if (orderMode === 'upload') {
          const selectedCard = productCards.find(card => card.dataset.productId === productType);
          STATE.designs = [{ url: imageDataUrls[0], label: 'Uploaded artwork', isFlat: true, styleDesc: 'Client-Provided Master Artwork' }];
          STATE.selectedDesign = 0;
          STATE.product = { name: selectedCard?.querySelector('strong')?.textContent || 'Product', icon: 'custom' };
          $('order-design-img').src = imageDataUrls[0];
          $('order-design-num').textContent = 'Master';
          $('order-product-name').textContent = STATE.product.name;
          goToStep('step-order');
          return;
        }

        const res = await fetch('/api/generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            description,
            images: imageDataUrls,
            productType,
            languages,
            brandId,
            industry,
            stylePreset
          }),
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Generation failed');

        clearTimeout(telemTimer1);
        clearTimeout(telemTimer2);
        $('telem-step-3').classList.add('completed');

        STATE.designs = data.designs || [];
        STATE.product = data.product;
        STATE.brief = data.brief;
        STATE.printSpec = data.printSpec;
        STATE.preflight = data.preflight;

        // Populate overlay editor from extracted brief
        if (data.brief?.extracted_text) {
          STATE.overlayData.name = data.brief.extracted_text.company_name || '';
          STATE.overlayData.tagline = data.brief.extracted_text.tagline || '';
          STATE.overlayData.phone = data.brief.extracted_text.phone || '';
          STATE.overlayData.email = data.brief.extracted_text.email || '';
          STATE.overlayData.location = data.brief.extracted_text.location || '';
        }
        if (data.brief?.color_roles?.accent) {
          STATE.overlayData.accent = data.brief.color_roles.accent;
        }

        // Sync inputs
        $('overlay-name').value = STATE.overlayData.name;
        $('overlay-tagline').value = STATE.overlayData.tagline;
        $('overlay-phone').value = STATE.overlayData.phone;
        $('overlay-email').value = STATE.overlayData.email;
        $('overlay-location').value = STATE.overlayData.location;
        $('overlay-accent').value = STATE.overlayData.accent;
        $('overlay-accent-val').textContent = STATE.overlayData.accent.toUpperCase();

        // Update preflight badges
        if (data.preflight) {
          $('preflight-score-badge').textContent = `${data.preflight.score} / 100`;
          $('preflight-bleed-title').textContent = `Bleed & Safe Zone (${data.printSpec.bleedMm}mm Margin)`;
          $('preflight-dpi-title').textContent = `Physical Resolution (${data.printSpec.dpi} DPI)`;
        }

        // Update sidebar summary
        $('summary-product-name').textContent = data.product?.name || 'Print Product';

        renderStudioConcepts();
        goToStep('step-pick');

      } catch (err) {
        clearTimeout(telemTimer1);
        clearTimeout(telemTimer2);
        $('request-error').textContent = err.message;
        $('request-error').hidden = false;
      } finally {
        btn.querySelector('.btn-text').hidden = false;
        btn.querySelector('.btn-loading').hidden = true;
        btn.disabled = false;
        telem.hidden = true;
      }
    });

    // --- Render Studio Concepts ---
    function renderStudioConcepts() {
      const grid = $('designs-grid');
      grid.innerHTML = '';

      STATE.designs.forEach((d, i) => {
        const card = document.createElement('div');
        card.className = `studio-concept-card ${STATE.selectedDesign === i ? 'selected' : ''}`;
        card.id = `concept-card-${i}`;
        card.onclick = () => selectConcept(i);

        const aspectClass = STATE.printSpec?.aspectRatio === 'landscape' ? 'aspect-landscape' : STATE.printSpec?.aspectRatio === 'portrait' ? 'aspect-portrait' : 'aspect-card';

        card.innerHTML = `
          <div class="concept-head">
            <div class="concept-badge-row">
              <span class="concept-chip">${d.label || ('Concept ' + (i + 1))}</span>
              <span class="concept-style-tag">${d.styleDesc || 'Orthographic Studio View'}</span>
            </div>
            <button type="button" class="btn-zoom-inspect" onclick="openLightbox(${i}, event)" title="Inspect Fullscreen at 300 DPI">
              🔍 Inspect
            </button>
          </div>

          <div class="concept-viewport-wrap ${aspectClass} ${STATE.viewMode === 'flat' ? 'mode-flat' : 'mode-mockup'}">
            <!-- Canvas Scene -->
            <div class="canvas-scene" id="canvas-scene-${i}">
              <img src="${d.url}" alt="Design Concept ${i + 1}" loading="lazy" class="canvas-art-img">
              
              <!-- Bleed Margin & Crop Marks Guide (Active in 2D Flat Mode) -->
              <div class="bleed-guide-overlay">
                <div class="bleed-box">
                  <span class="guide-tag">3mm BLEED SAFE ZONE</span>
                </div>
                <div class="crop-mark top-left"></div>
                <div class="crop-mark top-right"></div>
                <div class="crop-mark bottom-left"></div>
                <div class="crop-mark bottom-right"></div>
              </div>

              <!-- Live Typo-Proof Vector Overlay Layer -->
              <div class="canvas-overlay-content ${STATE.showOverlay ? '' : 'overlay-hidden'}" id="overlay-content-${i}">
                ${buildOverlayHTML()}
              </div>
            </div>
          </div>

          <div class="concept-footer">
            <div class="concept-facts">
              <span class="fact-dpi">300 DPI Press-Ready</span>
              <span class="fact-cmyk">Fogra39 CMYK</span>
            </div>
            <button type="button" class="btn-concept-select">
              ${STATE.selectedDesign === i ? '✓ Selected Direction' : 'Choose Direction'}
            </button>
          </div>
        `;
        grid.appendChild(card);
      });

      // Auto-select first concept if none selected
      if (STATE.selectedDesign === null && STATE.designs.length > 0) {
        selectConcept(0);
      }
    }

    function buildOverlayHTML() {
      const { name, tagline, phone, email, location, accent, font } = STATE.overlayData;
      if (!name && !tagline && !phone) return '';

      return `
        <div class="vector-overlay-badge" style="border-left-color: ${accent}; font-family: ${font};">
          ${name ? `<div class="vector-brand-name">${escapeHTML(name)}</div>` : ''}
          ${tagline ? `<div class="vector-brand-tagline">${escapeHTML(tagline)}</div>` : ''}
        </div>
        ${(phone || location || email) ? `
          <div class="vector-contact-bar" style="font-family: ${font}; border-bottom-color: ${accent};">
            ${phone ? `<span class="vector-item"><span class="v-icon">📞</span> ${escapeHTML(phone)}</span>` : ''}
            ${location ? `<span class="vector-item"><span class="v-icon">📍</span> ${escapeHTML(location)}</span>` : ''}
            ${email ? `<span class="vector-item"><span class="v-icon">✉️</span> ${escapeHTML(email)}</span>` : ''}
          </div>
        ` : ''}
      `;
    }

    function escapeHTML(str) {
      return String(str || '').replace(/[&<>'"]/g, tag => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
      }[tag] || tag));
    }

    // Live update overlay inputs
    function updateLiveOverlay() {
      STATE.overlayData.name = $('overlay-name').value;
      STATE.overlayData.tagline = $('overlay-tagline').value;
      STATE.overlayData.phone = $('overlay-phone').value;
      STATE.overlayData.email = $('overlay-email').value;
      STATE.overlayData.location = $('overlay-location').value;
      STATE.overlayData.accent = $('overlay-accent').value;
      STATE.overlayData.font = $('overlay-font').value;
      $('overlay-accent-val').textContent = STATE.overlayData.accent.toUpperCase();

      const html = buildOverlayHTML();
      STATE.designs.forEach((_, i) => {
        const el = $(`overlay-content-${i}`);
        if (el) el.innerHTML = html;
      });

      // Update lightbox if open
      const lb = $('lightbox-overlay');
      if (lb) lb.innerHTML = html;
    }

    function toggleVectorOverlay(show) {
      STATE.showOverlay = show;
      STATE.designs.forEach((_, i) => {
        const el = $(`overlay-content-${i}`);
        if (el) el.classList.toggle('overlay-hidden', !show);
      });
      const lb = $('lightbox-overlay');
      if (lb) lb.classList.toggle('overlay-hidden', !show);
    }

    function setStudioViewMode(mode) {
      STATE.viewMode = mode;
      $('view-mode-mockup').classList.toggle('active', mode === 'mockup');
      $('view-mode-flat').classList.toggle('active', mode === 'flat');

      document.querySelectorAll('.concept-viewport-wrap').forEach(wrap => {
        wrap.classList.toggle('mode-mockup', mode === 'mockup');
        wrap.classList.toggle('mode-flat', mode === 'flat');
      });
    }

    function selectConcept(index) {
      STATE.selectedDesign = index;
      document.querySelectorAll('.studio-concept-card').forEach((c, i) => {
        const isSelected = i === index;
        c.classList.toggle('selected', isSelected);
        const btn = c.querySelector('.btn-concept-select');
        if (btn) btn.textContent = isSelected ? '✓ Selected Direction' : 'Choose Direction';
      });

      $('btn-order').disabled = false;
      $('pick-hint').textContent = `Direction ${index + 1} selected · Ready for production review`;
    }

    // Lightbox / Zoom Inspector
    function openLightbox(index, ev) {
      if (ev) ev.stopPropagation();
      const d = STATE.designs[index];
      if (!d) return;

      $('lightbox-img').src = d.url;
      $('lightbox-label').textContent = `${d.label || ('Concept ' + (index + 1))} — 300 DPI Pre-Flight Zoom`;
      $('lightbox-overlay').innerHTML = buildOverlayHTML();
      $('lightbox-overlay').classList.toggle('overlay-hidden', !STATE.showOverlay);
      $('lightbox-modal').hidden = false;
    }

    function closeLightbox(ev) {
      if (!ev || ev.target.id === 'lightbox-modal' || ev.target.classList.contains('lightbox-close')) {
        $('lightbox-modal').hidden = true;
      }
    }

    // Continue to Step 3
    $('btn-order').addEventListener('click', () => {
      if (STATE.selectedDesign === null) return;
      const d = STATE.designs[STATE.selectedDesign];
      $('order-design-img').src = d.url;
      $('order-design-num').textContent = STATE.selectedDesign + 1;
      $('order-product-name').textContent = STATE.product?.name || 'Product';
      $('mockup-scene').className = `mockup-scene mockup-${STATE.product?.icon || 'custom'}`;
      $('order-overlay-content').innerHTML = buildOverlayHTML();
      $('order-overlay-content').classList.toggle('overlay-hidden', !STATE.showOverlay);
      goToStep('step-order');
    });

    document.querySelectorAll('input[name="fulfillmentType"]').forEach(input => input.addEventListener('change', () => {
      document.querySelectorAll('.fulfillment-card').forEach(card => card.classList.toggle('selected', card.contains(input)));
    }));

    // Submit Order
    $('order-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = e.target.querySelector('.btn-submit');
      btn.querySelector('.btn-text').hidden = true;
      btn.querySelector('.btn-loading').hidden = false;
      btn.disabled = true;
      $('order-error').hidden = true;

      const formData = new FormData(e.target);

      try {
        const res = await fetch('/api/orders', {
          method: 'POST',
          body: JSON.stringify({
            userDescription: STATE.description,
            designs: STATE.designs,
            selectedDesign: STATE.selectedDesign,
            customerName: formData.get('customerName'),
            customerEmail: formData.get('customerEmail'),
            customerPhone: formData.get('customerPhone') || null,
            productType: $('productType').value,
            fulfillmentType: formData.get('fulfillmentType'),
            quantity: $('quantity').value,
            overlayFields: STATE.overlayData
          }),
          headers: { 'Content-Type': 'application/json' },
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Order submission failed');

        $('order-form').hidden = true;
        $('order-success').hidden = false;
        $('payment-next-message').textContent = data.paymentConfigured
          ? 'Your order is saved. Tap below to complete payment via Sifalo Pay (Zaad / eDahab / EVC Plus).'
          : 'Online payment is currently processing. Your order is registered with our Hargeisa production team.';

        const orderLink = document.createElement('a');
        orderLink.className = 'btn-primary';
        orderLink.href = data.orderUrl;
        orderLink.style.display = 'inline-block';
        orderLink.style.marginTop = '20px';
        orderLink.textContent = data.paymentConfigured ? '📱 Complete Mobile Money Payment' : 'View Live Order Status';
        $('order-success').appendChild(orderLink);
      } catch (err) {
        $('order-error').textContent = err.message;
        $('order-error').hidden = false;
      } finally {
        btn.querySelector('.btn-text').hidden = false;
        btn.querySelector('.btn-loading').hidden = true;
        btn.disabled = false;
      }
    });

    document.querySelectorAll('.btn-back').forEach(btn => {
      btn.addEventListener('click', () => goToStep(btn.dataset.goto));
    });

    // --- WhatsApp Sharing ---
    function shareConceptOnWhatsApp() {
      const productName = STATE.product?.name || 'Design Product';
      const companyName = STATE.overlayData.name || 'My Brand';
      const conceptIdx = STATE.selectedDesign !== null ? STATE.selectedDesign + 1 : 1;
      const host = window.location.origin;
      const msg = `Asc! Waxaan rabaa inaad eegto proof-ka cusub ee ${productName} (${companyName}) - Concept ${conceptIdx}.\nFadlan toos ugu eeg SignPal: ${host}/design`;
      window.open(`https://wa.me/?text=${encodeURIComponent(msg)}`, '_blank');
    }

    // --- Bilingual UI Switcher ---
    const I18N = {
      en: {
        step1: 'Configure & Brief',
        step2: 'Interactive Studio & Proof',
        step3: 'Review & Sifalo Pay',
        stepTitle: 'Generate Production-Grade Print Designs in Seconds',
        stepSubtitle: 'No waiting 3 days for a busy designer. Select your product, pick an industry preset, and SignPal will synthesize 3 tailored, press-ready concepts with exact bleed margins.',
        btnGen: '⚡ Synthesize My 3 Concepts',
        studioTitle: 'Inspect, Tweak & Select Your Concept',
        studioSubtitle: 'Toggle between 3D Real-World Presentation and 2D Print Production view. Edit text fields in real-time with zero typos!',
        liveEditorTitle: 'Live Content & Text Overlay',
        liveEditorSub: 'Updates instantly on canvas — zero typos guaranteed',
        preflightTitle: 'Pre-Flight Production Auditor',
        preflightSub: 'Certified factory press readiness',
        btnOrder: 'Continue to Order with Selected Concept →',
        b2bSignageTitle: 'Architectural Signage & Illumination Profile',
        b2bSignageDesc: 'Custom fabrication settings for 3D channel letters, lightboxes & totems',
        b2bVehicleTitle: 'Fleet & Vehicle Wrap Specification',
        b2bVehicleDesc: 'Outdoor high-durability cast vinyl with UV lamination',
        b2bCorporateTitle: 'Complete Corporate Identity Suite',
        b2bCorporateDesc: 'Synchronized 4-item branding package ready for press & distribution',
        lblIllum: 'Illumination Style',
        lblSub: 'Mounting Facade Substrate',
        lblVType: 'Vehicle Model',
        lblCov: 'Wrap Coverage'
      },
      so: {
        step1: '01 Xul & Sharax',
        step2: '02 Istuudyaha & Proof-ka',
        step3: '03 Dib-u-eeg & Bixi',
        stepTitle: 'Ku Samee Naqshad Daabacaad Daqiiqado Gudahood',
        stepSubtitle: 'Ha sugin 3 maalmood naqshadeeye mashquul ah. Xulo alaabtaada, dooro nooca ganacsiga, SignPal-na waxay ku siinaysaa 3 naqshadood oo diyaar u ah daabacaad rasmi ah.',
        btnGen: '⚡ Samee 3-da Naqshadood ee AI-da',
        studioTitle: 'Istuudyaha Naqshadda & Hubinta Proof-ka',
        studioSubtitle: 'Kala beddel Muuqaalka 3D iyo Xaashida Daabacaadda 2D. Toos u sax qoraalka adigoo hubinaya inaysan jirin wax qalad ah!',
        liveEditorTitle: 'Qoraalka & Xogta Tooska ah ee Naqshadda',
        liveEditorSub: 'Toos ayuu ugu beddelmayaa naqshadda — 100% bilaa qalad',
        preflightTitle: 'Hubiyaha Daabacaadda ee Warshadda',
        preflightSub: 'Diyaar u ah daabacaadda rasmiga ah ee warshadda Hargeisa',
        btnOrder: 'Ku Soco Dalabka Naqshaddan La Doortay →',
        b2bSignageTitle: 'Habaynta & Iftiinka Boorarka 3D-ga',
        b2bSignageDesc: 'Xulashada farsamada xarafyada 3D, sanduuqyada ifaya & tiirarka',
        b2bVehicleTitle: 'Daabacaadda & Duubista Gaadiidka / Bajaajta',
        b2bVehicleDesc: 'Maaddada adag ee vinyl-ka ah oo u adkaysata qorraxda iyo boodhka',
        b2bCorporateTitle: 'Xirmo Dhamaystiran oo Shirkadeed',
        b2bCorporateDesc: '4 agab oo isku midab & naqshad ah oo diyaar u ah daabacaad rasmi ah',
        lblIllum: 'Nooca Iftiinka',
        lblSub: 'Gadaasha / Meesha Lagu Xidhayo',
        lblVType: 'Nooca Gaadhiga',
        lblCov: 'Xaddiga Duubista Vinyl-ka'
      }
    };

    function setStudioLanguage(lang) {
      const dict = I18N[lang] || I18N.en;
      if ($('lbl-step-1')) $('lbl-step-1').textContent = dict.step1;
      if ($('lbl-step-2')) $('lbl-step-2').textContent = dict.step2;
      if ($('lbl-step-3')) $('lbl-step-3').textContent = dict.step3;

      const reqTitle = document.querySelector('#step-request .step-title');
      if (reqTitle) reqTitle.textContent = dict.stepTitle;
      const reqSub = document.querySelector('#step-request .step-subtitle');
      if (reqSub) reqSub.textContent = dict.stepSubtitle;
      const btnGenText = $('btn-submit-generate')?.querySelector('.btn-text');
      if (btnGenText) btnGenText.textContent = dict.btnGen;

      const pickTitle = document.querySelector('#step-pick .step-title');
      if (pickTitle) pickTitle.textContent = dict.studioTitle;
      const pickSub = document.querySelector('#step-pick .step-subtitle');
      if (pickSub) pickSub.textContent = dict.studioSubtitle;
      const leTitle = document.querySelector('.live-editor-panel .panel-head h3');
      if (leTitle) leTitle.textContent = dict.liveEditorTitle;
      const leSub = document.querySelector('.live-editor-panel .panel-head p');
      if (leSub) leSub.textContent = dict.liveEditorSub;
      const pfTitle = document.querySelector('.preflight-panel .panel-head h3');
      if (pfTitle) pfTitle.textContent = dict.preflightTitle;
      const pfSub = document.querySelector('.preflight-panel .panel-head p');
      if (pfSub) pfSub.textContent = dict.preflightSub;
      if ($('btn-order')) $('btn-order').textContent = dict.btnOrder;

      // B2B Configurator Labels
      if ($('b2b-signage-title')) $('b2b-signage-title').textContent = dict.b2bSignageTitle;
      if ($('b2b-signage-desc')) $('b2b-signage-desc').textContent = dict.b2bSignageDesc;
      if ($('b2b-vehicle-title')) $('b2b-vehicle-title').textContent = dict.b2bVehicleTitle;
      if ($('b2b-vehicle-desc')) $('b2b-vehicle-desc').textContent = dict.b2bVehicleDesc;
      if ($('b2b-corporate-title')) $('b2b-corporate-title').textContent = dict.b2bCorporateTitle;
      if ($('b2b-corporate-desc')) $('b2b-corporate-desc').textContent = dict.b2bCorporateDesc;
      if ($('lbl-illumination')) $('lbl-illumination').textContent = dict.lblIllum;
      if ($('lbl-substrate')) $('lbl-substrate').textContent = dict.lblSub;
      if ($('lbl-vehicletype')) $('lbl-vehicletype').textContent = dict.lblVType;
      if ($('lbl-coverage')) $('lbl-coverage').textContent = dict.lblCov;

      $('lang-btn-en').classList.toggle('active', lang === 'en');
      $('lang-btn-so').classList.toggle('active', lang === 'so');

      localStorage.setItem('signpal_studio_lang', lang);
    }

    // Check saved language
    try {
      const savedLang = localStorage.getItem('signpal_studio_lang');
      if (savedLang === 'so') setStudioLanguage('so');
    } catch (_) {}
  </script>
</body>
</html>
